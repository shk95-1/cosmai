#!/usr/bin/env python3
"""Prints in one line which version the vector store is (fork #49).

It is **the same string** `cosmai retrieval eval` puts on every vector and hybrid row -- the way to confirm
again the version the contract (`contracts/interfaces.md` §Retrieval measurements) wrote down, and that is why
it reads the manifest and the id list only: it does not open the 1.2GB matrix, so it needs neither a GPU nor
several minutes.

The count is **the number of rows in the id file**, not the `count` the manifest claims. When the two
diverge it prints no version and blocks -- a store whose word about itself differs from the fact is the
same place `vectors.load` refuses.

    tool/show-vector-stamp                             # var/retrieval/vectors/e5base
    tool/show-vector-stamp var/retrieval/vectors/e5base

exit codes: 0 the version was printed · 2 the store cannot be read (no file · a broken manifest · a required
key missing · a count disagreement -- the same place as blocked in `contracts/entrypoints.md` §Search). There
is no 1: there is no such thing as a half-read version, so if it printed, that line is whole.
"""

from __future__ import annotations

import argparse
import csv
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from analysis.retrieval import vectors  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "store",
        nargs="?",
        default=str(vectors.DEFAULT_STORE),
        help="Store path (without the extension). Default is vectors.DEFAULT_STORE.",
    )
    args = parser.parse_args()

    out = Path(args.store)
    _, ids_path, manifest_path = vectors.paths(out)
    missing = [p.name for p in (ids_path, manifest_path) if not p.exists()]
    if missing:
        print(f"cannot read the store: {', '.join(missing)} is missing ({out.parent})", file=sys.stderr)
        return 2
    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as broken:
        print(f"cannot read the manifest: {manifest_path} ({broken})", file=sys.stderr)
        return 2
    if absent := [key for key in vectors.REQUIRED_MANIFEST if key not in manifest]:
        print(f"the manifest has no {', '.join(absent)}: {manifest_path}", file=sys.stderr)
        return 2
    with ids_path.open(encoding="utf-8", newline="") as handle:
        count = sum(1 for _ in csv.DictReader(handle))
    if manifest.get("count") not in (None, count):
        print(
            f"the manifest says {manifest['count']} but the ids are {count}: {out}",
            file=sys.stderr,
        )
        return 2
    try:
        print(vectors.manifest_stamp(manifest, count))
    except ValueError as empty:
        print(f"{empty}: {manifest_path}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
