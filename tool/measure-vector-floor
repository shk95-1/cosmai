#!/usr/bin/env python3
"""Measures on our corpus whether a similarity floor **can be put** on vector search (fork #48, ydc's
`vector_threshold.py`).

`search` in `analysis/retrieval/vectors.py` has no floor -- it sorts by cosine and gives the top k as
they are. Ask for something the corpus does not have and 10 results still come out and get printed as
evidence. That is not a reason to put one in on "a floor would be nice": **e5 cosines cluster in a
narrow band** (this is query-document, not document-document), and unless the distributions actually
separate, a floor only works towards letting irrelevant results through while cutting right ones.

**The three verdict criteria were fixed before measuring** (the body of issue #48 = exactly what ydc
fixed in advance). Making the criteria after seeing the result is what this measurement is there to
stop, so they live only in the two constants `KEEP`·`CUT` and the one function `verdict`, and
`tests/retrieval/test_vector_floor.py` holds their meaning.

    분리가 된다   가짜 질의의 최고 코사인 < 진짜 질의의 최저 코사인
    쓸 수 있다    겹치더라도 정탐을 KEEP 이상 남기는 문턱에서 오탐을 CUT 이상 자른다
    못 쓴다       위 둘 다 아니다

**The real queries are not picked** -- they are the topic aliases `cosmai retrieval eval --mode literal`
uses, and since the canonical copy is the active version of `needs.aspect_lexicon`, they are read from
the DB. **That the fake queries are absent from the corpus is checked every time**: if even one is
really there it is not fake, and the numbers over that sample are not to be trusted (exit code 1).

The value measured is the **highest cosine** (top-1) per query. The store is L2 normalized, so the
distance `vectors.search` gives is turned back with `1 - distance`.

The two parts have **different** heavy dependencies. `cosine` opens the vector store and the encoder
(the `embed` extra), while `df` opens the BM25 index (over ten minutes without a cache). So they can be
called separately.

    uv run --extra retrieval --extra embed tool/measure-vector-floor            # both
    uv run --extra retrieval --extra embed tool/measure-vector-floor --json
    uv run --extra retrieval tool/measure-vector-floor --part df                # uses neither encoder nor GPU

Measuring 73 queries on the CPU takes 11 seconds, so the default device is `cpu` -- no reason to take
a shared GPU.

종료 코드: 0 답이 계산됐다 · 1 표본이 가짜가 아니다(코퍼스에 실제로 있다 -- 이 산출을 믿지 마라) ·
2 막힘(벡터 저장소를 못 읽는다 · 인코더가 없다 · 활성 주제 사전이 없다 -- `contracts/entrypoints.md`
§검색 의 blocked 와 같은 자리다).
"""

from __future__ import annotations

import argparse
import json
import statistics
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from analysis.retrieval import eval as retrieval_eval  # noqa: E402
from analysis.retrieval import grounding, topics, vectors  # noqa: E402

# 코퍼스에 없는 성분명처럼 생긴 말. ydc `vector_threshold.py` v0.3.0 의 목록 **그대로**다 -- 우리가 다시
# 지으면 그 짓는 규칙이 또 하나의 손잡이가 된다. 실제 성분명처럼 보이도록 접미사(`-사이드`·`-오일`·
# `추출물`)를 붙였고, 라틴·키릴 표기를 섞은 것은 한글만으로는 인코더의 문자 편향을 못 보기 때문이다.
FAKE = (
    "퀀텀펩타이드사이드",
    "하이드로실록산잔텀",
    "메가비타플렉소사이드",
    "젤라토프로틴추출물",
    "네오콜라제닌오일",
    "울트라세라마이덤",
    "포토리포좀아쿠아",
    "바이오크리스탈렌",
    "трансдермалин",
    "zylophosphatide",
    "neocryolipide",
    "hydraxanthenol",
)
KEEP = 0.90  # the share of true positives the threshold has to keep
CUT = 0.50  # the share of false positives that threshold has to cut
YDC_TRIAL = 0.865  # what ydc put in provisionally off 6 samples. Its thin ground starts this measurement
ROUTING_TOOL = ROOT / "tool" / "measure-query-routing"
# The branches discarded while choosing, as opposed to the rule the gate uses. The value is "the minimum
# token length at which df 0 counts as ground", and None is ydc's first edition, "every token has df 0".
DISCARDED = {"all_zero": None, "any_len3": 3}
SEPARATED = "분리가 된다"
USABLE = "쓸 수 있다"
UNUSABLE = "못 쓴다"


def presence(conn, names: tuple[str, ...]) -> dict[str, int]:
    """The number of chunks carrying each name. **Counted in one scan** -- asking per name makes a full
    scan every time for a name that is absent, and there is no guarantee those twelve fit inside
    statement_timeout (30s)."""
    counted = ", ".join("count(*) FILTER (WHERE text LIKE %s)" for _ in names)
    with conn.cursor() as cur:
        cur.execute(f"SELECT {counted} FROM retrieval_chunk", tuple(f"%{name}%" for name in names))  # noqa: S608
        row = cur.fetchone() or ()
    conn.commit()  # a 1.2GB matrix and the model are opened next -- do not leave with a transaction open
    return dict(zip(names, (int(n) for n in row), strict=True))


def top_cosine(store, encoder, queries: list[str]) -> list[tuple[str, float]]:
    """(query, highest cosine). `search` gives a distance, so it is turned back with `1 - distance`."""
    from analysis.retrieval import embed

    found = []
    for query in queries:
        hits = vectors.search(store, embed.encode_query(query, store=store, encoder=encoder), top=1)
        found.append((query, 1.0 - hits[0][1] if hits else 0.0))
    return found


def highest_keeping(real: list[float], keep: float = KEEP) -> float:
    """The **highest** threshold that keeps at least `keep` of the true positives. A threshold is always
    one measured value -- picking a number between values makes the rule for picking it a handle."""
    best = min(real)
    for candidate in sorted(real):
        if sum(1 for score in real if score >= candidate) / len(real) >= keep:
            best = candidate
    return best


def verdict(real: list[float], fake: list[float]) -> tuple[str, float | None]:
    """Judges by the criteria fixed in advance. **The criteria are not made after seeing the result.**"""
    if not real or not fake:
        return ("측정 불가", None)
    if max(fake) < min(real):
        # Without overlap the threshold can be anywhere between the two distributions, so the middle is given.
        return (SEPARATED, (max(fake) + min(real)) / 2)
    threshold = highest_keeping(real)
    cut = sum(1 for score in fake if score < threshold) / len(fake)
    return (USABLE if cut >= CUT else UNUSABLE, threshold)


def spread(scores: list[float]) -> dict:
    """The quartiles are exactly where ydc took them -- a position in the sorted list, not interpolated."""
    ordered = sorted(scores)
    return {
        "n": len(ordered),
        "min": ordered[0],
        "p25": ordered[len(ordered) // 4],
        "median": statistics.median(ordered),
        "p75": ordered[3 * len(ordered) // 4],
        "max": ordered[-1],
    }


def at(threshold: float, real: list[float], fake: list[float]) -> dict:
    """What one threshold cuts. It gives the cut side together with the kept side -- the block count
    alone looks good."""
    return {
        "threshold": threshold,
        "real_lost": sum(1 for score in real if score < threshold),
        "real": len(real),
        "fake_blocked": sum(1 for score in fake if score < threshold),
        "fake": len(fake),
    }


def band_of(rows: list[tuple[str, float]], *, low: bool) -> dict | None:
    """One distribution and its five edge values. **None when the sample is empty** -- a quantile is not
    invented over a sample that does not exist."""
    scores = [score for _query, score in rows]
    if not scores:
        return None
    edge = sorted(rows, key=lambda row: row[1] if low else -row[1])[:5]
    return {**spread(scores), "lowest" if low else "highest": edge}


def csv_dictionary() -> topics.Topics:
    """One load-source CSV. It takes the same conversion `cosmai lexicon load` uses but **does not stand it
    up in the process** -- the canonical copy this tool measures is the active dictionary, and this is
    what that active dictionary is compared against."""
    from cosmai.cli import _csv_rows
    from db.lexicon import ASPECT_COLUMNS

    aspect, pattern, extra = (ASPECT_COLUMNS.index(column) for column in ("aspect", "pattern", "extra"))
    rows = _csv_rows("aspect", str(topics.DICTIONARY_CSV))
    return topics.from_rows([(str(row[aspect]), str(row[pattern]), row[extra]) for row in rows], 1)


def literal_queries(dictionary: topics.Topics) -> list[str]:
    """The queries `retrieval eval --mode literal` uses. A person does not pick them."""
    return [query for _topic, query in retrieval_eval.queries("literal", dictionary)]


def same_as_csv(queries: list[str]) -> dict:
    """활성 사전의 질의가 적재 원본 CSV 의 것과 같은가. 계약이 §검색 실측 과 이 표를 잇는 근거이고,
    사전 판본이 갈린 뒤로는 **이것이 맞댈 수 있는 유일한 짝**이다(옛 버전 행은 DB 에 없다)."""
    from_csv = literal_queries(csv_dictionary())
    return {"same": from_csv == queries, "csv": len(from_csv), "active": len(queries)}


def measure_cosine(conn, store, device: str | None) -> dict:
    from analysis.retrieval import embed

    dictionary = topics.use_active(conn)
    real_queries = literal_queries(dictionary)
    found = presence(conn, FAKE)
    encoder = embed.load_encoder(store.model, device)
    real = top_cosine(store, encoder, real_queries)
    fake = top_cosine(store, encoder, [name for name in FAKE if not found[name]])
    real_scores = [score for _query, score in real]
    fake_scores = [score for _query, score in fake]
    kind, threshold = verdict(real_scores, fake_scores)
    band = band_of(real, low=True)
    measured = {
        "store": store.stamp,
        # The same weight on both axes: a stamp, not a bare number -- rows can be added to the
        # active version and the number stays (#62, #68).
        "dictionary": dictionary.stamp,
        "csv_queries": same_as_csv(real_queries),
        "present": {name: count for name, count in found.items() if count},
        "real": band,
        "fake": band_of(fake, low=False),
        "verdict": kind,
    }
    if not (band and fake_scores):
        # With one sample empty, both the verdict and the overlap would be invented -- that is the case
        # where every fake is in the corpus, and `present` says what caused it while exit code 1 says not
        # to trust this output.
        return measured
    return {
        **measured,
        "overlap": max(fake_scores) >= min(real_scores),
        "at_threshold": at(threshold, real_scores, fake_scores) if threshold else None,
        "at_ydc_trial": at(YDC_TRIAL, real_scores, fake_scores),
        # The size of the overlap. With "they overlap" alone, grazing and clustering look the same.
        "real_below_fake_max": sum(1 for score in real_scores if score < max(fake_scores)),
        "fake_inside_real_quartiles": sum(1 for score in fake_scores if band["p25"] <= score <= band["p75"]),
    }


def frames() -> tuple[str, ...]:
    """The ten sentence frames. **The canonical copy is #47's tool** -- a second copy diverges, and then
    this sample no longer inherits that side's finding that "a frame emits no ingredient signal"."""
    from importlib.machinery import SourceFileLoader
    from importlib.util import module_from_spec, spec_from_loader

    spec = spec_from_loader(
        "measure_query_routing", SourceFileLoader("measure_query_routing", str(ROUTING_TOOL))
    )
    if spec is None or spec.loader is None:  # pragma: no cover - a missing file is blocked below
        raise FileNotFoundError(ROUTING_TOOL)
    module = module_from_spec(spec)
    spec.loader.exec_module(module)
    return tuple(module.FRAMES)


def zero_df(query: str, index, minimum: int | None) -> bool:
    """Does a discarded branch block this query. With `minimum` None it is ydc's first edition, "all 0"."""
    from analysis.retrieval import bm25

    frequency = {term: len(index.postings.get(term, ())) for term in set(bm25.tokenize(query))}
    if not frequency:
        return False  # with no tokens, no branch judges by df
    if minimum is None:
        return max(frequency.values()) == 0
    return any(not df and len(term) >= minimum for term, df in frequency.items())


def measure_df(conn, sources: tuple[str, ...] | None = None) -> dict:
    """**The number of blocked queries** per rule and per sample. The line for the rule in use is produced
    by `grounding.check` itself -- writing it out again here would make the contract's table measure a
    copy rather than the implementation."""
    from analysis.retrieval import pipeline

    dictionary = topics.use_active(conn)
    index, _origin = pipeline.load_index(conn, sources)
    real = literal_queries(dictionary)
    shapes = frames()
    samples = {
        "real_alias": real,
        "real_sentence": [frame.format(alias=alias) for alias in real for frame in shapes],
        "fake_name": list(FAKE),
        "fake_sentence": [frame.format(alias=name) for name in FAKE for frame in shapes],
    }
    rules: dict[str, dict[str, int]] = {name: {} for name in ("all_zero", "any_len3", "in_use")}
    for sample, queries in samples.items():
        for name, minimum in DISCARDED.items():
            rules[name][sample] = sum(1 for query in queries if zero_df(query, index, minimum))
        rules["in_use"][sample] = sum(1 for query in queries if not grounding.check(query, index).ok)
    return {
        "dictionary": dictionary.stamp,  # a stamp, not a bare number (#68)
        "csv_queries": same_as_csv(real),
        "minimum_length": grounding.ZERO_DF_MINLEN,
        "frames": len(shapes),
        "sizes": {sample: len(queries) for sample, queries in samples.items()},
        "rules": rules,
        # The fakes it cannot block are given by name. A count alone reads as "a few leak" and erases
        # which property is leaking.
        "unblocked_fakes": [name for name in FAKE if grounding.check(name, index).ok],
    }


def report_cosine(found: dict) -> None:
    print(f"store {found['store']} · active topic dictionary {found['dictionary']}")
    same = found["csv_queries"]
    verdict_csv = "same" if same["same"] else "different"
    print(f"  {same['active']} queries · {verdict_csv} from the load-source CSV ({same['csv']})")
    if found["present"]:
        print(f"[가짜가 아니다] 코퍼스에 실제로 있는 후보 {found['present']}")
    for label, key, edge in (
        ("real queries (topic aliases)", "real", "lowest"),
        ("fake queries (absent ingredient names)", "fake", "highest"),
    ):
        band = found[key]
        if band is None:
            print(f"\n{label} 최고 코사인  표본이 비었다 -- 분포를 낼 수 없다")
            continue
        print(
            f"\n{label} highest cosine  n={band['n']}\n"
            f"  min {band['min']:.4f} · 25% {band['p25']:.4f} · median {band['median']:.4f} "
            f"· 75% {band['p75']:.4f} · max {band['max']:.4f}"
        )
        print(f"  {'lowest' if edge == 'lowest' else 'highest'} 5: ", end="")
        print(" ".join(f"{query}={score:.3f}" for query, score in band[edge]))
    print(f"\nverdict: **{found['verdict']}**", end="")
    if "overlap" not in found:
        print(" -- one sample is empty, so neither overlap nor threshold can be given")
        return
    print(f" · overlap {'yes' if found['overlap'] else 'no'}")
    print(
        f"  real {found['real_below_fake_max']}/{found['real']['n']} below the fake maximum "
        f"· fake {found['fake_inside_real_quartiles']}/{found['fake']['n']} inside the real quartiles"
    )
    for label, line in (
        ("90% true-positive threshold", found["at_threshold"]),
        ("ydc trial value", found["at_ydc_trial"]),
    ):
        if not line:
            continue
        print(
            f"  {label} {line['threshold']:.4f}: real {line['real_lost']}/{line['real']} cut "
            f"· fake {line['fake_blocked']}/{line['fake']} blocked"
        )


def report_df(found: dict) -> None:
    labels = {
        "all_zero": "all 0 (ydc first edition)",
        "any_len3": "any 0 · length >= 3",
        "in_use": f"any 0 · length >= {found['minimum_length']} (the rule in use)",
    }
    same = found["csv_queries"]
    print(
        f"\nblocked queries · active topic dictionary {found['dictionary']} · {found['frames']} frames "
        f"· the queries are {'the same as' if same['same'] else 'different from'} the load-source CSV"
    )
    for name, label in labels.items():
        counts = " · ".join(
            f"{sample} {found['rules'][name][sample]}/{size}" for sample, size in found["sizes"].items()
        )
        print(f"  {label}\n      {counts}")
    print(f"  fakes it cannot block: {found['unblocked_fakes']}")


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("--vectors", default=None, help="Vector store path. Default is vectors.DEFAULT_STORE")
    parser.add_argument("--device", default="cpu", help="Encoder device. Default cpu -- there are 73 queries")
    parser.add_argument(
        "--part",
        choices=("all", "cosine", "df"),
        default="all",
        help="cosine opens the store and the encoder, df opens the BM25 index. Different heavy dependencies",
    )
    parser.add_argument("--json", action="store_true", help="The form the tests and the report read")
    args = parser.parse_args()

    from cosmai.cli import _connect

    try:
        conn = _connect(None)
    except (ValueError, LookupError) as refused:
        print(refused, file=sys.stderr)
        return 2
    found: dict = {}
    try:
        with conn:
            if args.part in ("all", "cosine"):
                store = vectors.load(Path(args.vectors) if args.vectors else vectors.DEFAULT_STORE)
                found["cosine"] = measure_cosine(conn, store, args.device)
            if args.part in ("all", "df"):
                found["df"] = measure_df(conn)
    # A missing encoder (the embed extra not installed) is blocked rather than a failure -- load_encoder
    # says what to install and how, in a RuntimeError.
    except (vectors.StoreMissing, topics.NoDictionary, RuntimeError) as blocked:
        print(blocked, file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps(found, ensure_ascii=False, indent=2))
    else:
        if "cosine" in found:
            report_cosine(found["cosine"])
        if "df" in found:
            report_df(found["df"])
    # If something that is not fake was in the sample, even after removing it these numbers are not
    # numbers over the sample the contract writes down.
    return 1 if found.get("cosine", {}).get("present") else 0


if __name__ == "__main__":
    raise SystemExit(main())
