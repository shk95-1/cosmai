def baseline(path: Path | None = None) -> topics.Topics:
    """원장의 표기를 하나도 안 가진 사전. DB 를 안 쓰고 적재 원본을 읽는다 -- `tests/retrieval/conftest.py`
    가 DB 없는 유닛에 쓰는 바로 그 길이라 사전이 두 벌이 되지 않는다."""
    from cosmai.cli import _csv_rows
    from db.lexicon import ASPECT_COLUMNS

    aspect, pattern, extra = (ASPECT_COLUMNS.index(c) for c in ("aspect", "pattern", "extra"))
    listed = {(row.place, row.term) for row in LEDGER}
    rows = [
        (str(r[aspect]), str(r[pattern]), r[extra])
        for r in _csv_rows("aspect", str(path or topics.DICTIONARY_CSV))
        if (str(r[aspect]), str(r[pattern])) not in listed
    ]
    return topics.from_rows(rows, 0)


def matcher(row: Row):
    if row.kind == "latin":
        pattern = topics.latin_pattern([row.term])
        assert pattern is not None
        return lambda text, lowered: bool(pattern.search(text))
    needle = row.term.lower()
    return lambda text, lowered: needle in lowered


def measure(corpus: Path, known: topics.Topics) -> dict:
    """한 번 훑어 세 수를 다 낸다 -- `known` 은 원장의 표기를 뺀 기준 사전이다. 26만 문서를 표기마다
    다시 도는 것은 같은 파일을 열다섯 번 읽는 것이다."""
    tests = [(row, matcher(row)) for row in LEDGER]
    df = {row.term: 0 for row in LEDGER}
    new = dict(df)
    unseen = dict(df)
    documents = 0
    with corpus.open(encoding="utf-8-sig", newline="") as handle:
        for record in csv.DictReader(handle):
            documents += 1
            text = record["text"] or ""
            lowered = text.lower()
            hits = None
            for row, hit in tests:
                if not hit(text, lowered):
                    continue
                df[row.term] += 1
                if hits is None:
                    hits = set(topics.match_topics(text, include_excluded=True, dictionary=known))
                if not hits:
                    unseen[row.term] += 1
                # 브랜드 자리의 표기는 주제 사전이 볼 일이 아니다 -- new 를 세면 축이 다른 수가 된다.
                if row.place != BRAND and row.place not in hits:
                    new[row.term] += 1
    return {"documents": documents, "df": df, "new": new, "unseen": unseen}


def misses(measured: dict) -> list[str]:
    """원장이 코퍼스와 갈린 자리. 비어 있으면 원장을 그대로 믿어도 된다."""
    out = []
    for row in LEDGER:
        df, new = measured["df"][row.term], measured["new"][row.term]
        if row.verdict == LISTED and df < MIN_DOCS:
            out.append(f"floor   {row.term}: df {df} < {MIN_DOCS} — 등재 근거가 무너졌다")
        if row.verdict == LISTED and (new == 0) != (row.new == 0):
            out.append(
                f"idle    {row.term}: new {new}, 원장은 {row.new} — 이 행이 무엇을 관측하는지가 달라졌다"
            )
        if row.verdict != LISTED and df >= MIN_DOCS and new > 0 and row.new == 0:
            out.append(f"revived {row.term}: df {df} · new {new} — 미등재 근거가 사라졌다")
    return out


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("--corpus", type=Path, default=CORPUS, help="document.csv (default: %(default)s)")
    parser.add_argument("--json", action="store_true", help="기계가 읽는 형식")
    args = parser.parse_args(argv)

    measured = measure(args.corpus, baseline())
    failures = misses(measured)
    if args.json:
        print(json.dumps({**measured, "misses": failures, "floor": MIN_DOCS}, ensure_ascii=False, indent=2))
        return 1 if failures else 0
    print(f"문서 {measured['documents']:,} · 바닥 MIN_DOCS {MIN_DOCS}")
    print(f"{'표기':12s} {'자리':18s} {'판정':6s} {'df':>7s} {'new':>6s} {'unseen':>7s}  근거")
    for row in LEDGER:
        print(
            f"{row.term:12s} {row.place:18s} {row.verdict:6s} "
            f"{measured['df'][row.term]:7,d} {measured['new'][row.term]:6,d} "
            f"{measured['unseen'][row.term]:7,d}  {row.why}"
        )
    for failure in failures:
        print(failure)
    return 1 if failures else 0


if __name__ == "__main__":
    raise SystemExit(main())
