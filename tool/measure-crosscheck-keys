#!/usr/bin/env python3
"""Re-measures what the substring lists catch **in the table as it is now** and compares that with the
confirmed list (fork #7).

Ingredient keys and polarity hints are both substrings over vendor strings, so they suffer the same
illness -- which is why one tool measures both together.

계약 §성분 이 지는 문장이 이것이다: *키가 무엇을 잡는지는 사람이 한 번 읽어 확인했고, 코퍼스가 자라
새 물질이 어떤 키에 들어오면 그 사실이 드러나야 한다.* **CI 는 그 일을 할 수 없다** -- 운영 표에 닿지
못하고, 픽스처에 고정한 문자열 몇 개는 코퍼스가 자라도 절대 깨지지 않는다. 그래서 이 스크립트가 그
길이고(#6 의 `tool/measure-evidence-fixture` 와 같은 자리), `tests/test_crosscheck_keys.py` 는 목록
자체의 자기 정합만 진다.

What is red.

  denied  어느 키든 `DENIED_NAMES` 를 잡았다. 이미 아는 오매칭이 되살아난 것이다 (`시카` 사고).
  new     an ingredient name that is not in the confirmed list entered that key. **It may or may not
          be a mismatch** -- telling the two apart is what a person reading this output does, and once
          read a line is added to the CSV.

`gone` (a name that was there disappearing) is not red -- a product dropping out is not a mismatch.

    tool/measure-crosscheck-keys                      # production needs_runtime
    tool/measure-crosscheck-keys --url <url>
    tool/measure-crosscheck-keys --json               # the machine-readable form
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from analysis import crosscheck  # noqa: E402
from analysis.crosscheck.pipeline import COMMERCE_SCHEMA, FORMULA, _commerce  # noqa: E402
from db.runtime import runtime_url  # noqa: E402
from db.seed._common import connect  # noqa: E402


def measure(url: str, schema: str) -> dict[str, dict[str, int]]:
    """Reads the (product, ingredient name) rows and gives, per key, the distinct names it catches and
    how many products carry each."""
    with connect(url) as conn, conn.cursor() as cur:
        cur.execute(_commerce(schema, FORMULA), ())
        rows = [
            (f"{source}:{product}", name)
            for source, product, ingredients in cur.fetchall()
            for name in crosscheck.parse_ingredients(ingredients)
        ]
        conn.commit()
    found: dict[str, dict[str, set[str]]] = {key: {} for key in crosscheck.INGREDIENT_KEYS}
    for product, name in rows:
        for key, terms in crosscheck.INGREDIENT_KEYS.items():
            if crosscheck.matches(name, terms):
                found[key].setdefault(name, set()).add(product)
    print(f"{len(rows):,} rows · {len({name for _p, name in rows}):,} distinct names", file=sys.stderr)
    return {key: {name: len(products) for name, products in names.items()} for key, names in found.items()}


VOCABULARY = """
SELECT topic_group, topic_name, count(*) FROM {topic}
 WHERE topic_group = ANY(%(groups)s) AND share_pct IS NOT NULL
 GROUP BY 1, 2 ORDER BY 1, 2
"""


def polarity_drift(url: str, schema: str) -> list[tuple[str, str, int, str, str]]:
    """Reads the whole choice vocabulary of the `GROUP_MAP` groups and gives **what is not in the
    confirmed table**.

    없는 것은 힌트가 답하는데, 힌트가 뒤집는 문구가 실측으로 다섯이다 (`자극이 있어요` · `약간
    건조해요` · `예상보다 짧아요` 둘 · `날림이 없어요`). 그래서 표에 없는 문구는 전부 사람이 읽어야 한다.
    """
    with connect(url) as conn, conn.cursor() as cur:
        cur.execute(_commerce(schema, VOCABULARY), {"groups": list(crosscheck.GROUP_MAP)})
        rows = cur.fetchall()
        conn.commit()
    known = crosscheck.confirmed_polarity()
    return [
        (group, name, count, crosscheck.polarity(name), known.get((group, name), ""))
        for group, name, count in rows
        if (group, name) not in known
    ]


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("--url", default=None, help="SQLAlchemy URL; default is needs_runtime.")
    parser.add_argument("--schema", default=COMMERCE_SCHEMA, help="Schema holding trend_radar.product.")
    parser.add_argument("--json", action="store_true", help="Print only in the machine-readable form.")
    args = parser.parse_args()

    now = measure(args.url or runtime_url(), args.schema)
    known = crosscheck.known_names()
    report: dict[str, dict[str, list[str]]] = {}
    bad = 0
    for key, names in now.items():
        denied = crosscheck.denied_in(key, names)
        new = sorted(set(names) - known[key])
        gone = sorted(known[key] - set(names))
        report[key] = {"denied": list(denied), "new": new, "gone": gone}
        bad += len(denied) + len(new)
        if args.json:
            continue
        print(f"{key}  {len(names)} kinds / {len(known[key])} confirmed")
        for name in denied:
            print(f"  [denied] {name} -- {crosscheck.denial_reason(key, name)}")
        for name in new:
            print(f"  [new] {name} ({names[name]} products) -- read it, judge it and add it to the list")
        for name in gone:
            print(f"   (gone) {name}")
    drift = polarity_drift(args.url or runtime_url(), args.schema)
    report["_polarity"] = {"unconfirmed": [f"{group}/{name}" for group, name, *_rest in drift]}
    bad += len(drift)
    if args.json:
        print(json.dumps(report, ensure_ascii=False, indent=2, sort_keys=True))
        return 0 if bad == 0 else 1
    print(f"\npolarity  GROUP_MAP group choice vocabulary -- {len(drift)} not in the confirmed table")
    for group, name, count, guess, _known in drift:
        print(f"  [new] {group}/{name} ({count} rows) -- hint says {guess}. read it and add to the list")
    if bad:
        print(f"\n[fail] {bad} for a person to read. once read, update {crosscheck.KNOWN_NAMES_CSV}")
        return 1
    print("\n[pass] the ingredient names the keys catch are exactly the confirmed list")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
