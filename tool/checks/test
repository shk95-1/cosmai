#!/bin/sh
# Tests against a real Postgres. A throwaway postgres:18 is started only when TEST_POSTGRES_URL
# is unset, then db/migrate.sh -- the SAME script production runs -- applies db/bootstrap.sql,
# the needs migration ledger and contracts/ddl/needs/*.sql. Removed on exit.
#
# `tool/checks/test` alone is that whole suite. `tool/checks/test --changed [<base>]` asks what the
# change can break first (#215) and runs the smallest verification that answers it:
#
#   A  the whole suite      the database, the packaging, the gate itself, or anything unmapped
#   B  the mapped tests + the DB-free suite    code under one package (tests/scope.toml)
#   C  format·lint·lang + the snapshot tests   prose, or code tool/checks/invariants proves is unmoved
set -e
. tool/checks/prerequisite
. tool/checks/suite-lock
. tool/checks/tested-tree

# git exports GIT_DIR/GIT_WORK_TREE/GIT_INDEX_FILE to hooks. Left in place, a test that runs git in a
# temporary repository commits into THIS checkout instead (it happened: a "chore: seed" fixture
# commit landed on a real branch during pre-push). The suite must see the same environment under
# a hook as from a terminal. PYTEST_ADDOPTS for the same reason and a sharper one: an inherited
# -k/-m/-x/--lf narrows the run, and a narrowed run must never write a cache entry every worktree
# of this clone then trusts (#214). Unset before the classifier below, which asks git where it is.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR PYTEST_ADDOPTS

change_class=A
change_reason="no --changed: the whole suite was asked for"
change_tests=""
if [ "$1" = "--changed" ]; then
    require_command python3 git
    # Three lines: the class, the reason, the test paths. The classifier is the only thing that
    # decides this, so a checkout where it cannot run has no partial mode -- it has the full suite.
    if change_scope=$(python3 tool/change_scope.py "${2:-origin/main}"); then
        change_class=$(printf '%s\n' "$change_scope" | sed -n 1p)
        change_reason=$(printf '%s\n' "$change_scope" | sed -n 2p)
        change_tests=$(printf '%s\n' "$change_scope" | sed -n 3p)
    else
        change_reason="the classifier could not answer, so the change is worth the whole suite"
    fi
    case "$change_class" in
        A | B | C) ;;
        *) change_reason="the classifier said '$change_class', which is not a class"; change_class=A ;;
    esac
elif [ -n "$1" ]; then
    printf 'usage: tool/checks/test [--changed [<base>]]\n' >&2
    exit 2
fi
printf 'verification: class %s — %s\n' "$change_class" "$change_reason"

# Class C touches no database, so a host without docker can still run it.
if [ "$change_class" = C ]; then
    require_command uv
else
    require_command uv docker pg_isready
fi

# Before anything runs: what the suite proves is the tree it started against, not whatever HEAD has
# become seventeen minutes later, and not a tree plus uncommitted edits (#214).
tested_tree_capture

# One exit path for everything this run holds: the slot it took, the container it started, the
# secret file, and -- only when pytest came back green -- the tested-tree entry that lets the next
# push of this same tree skip the suite (#214). Killed or failed, this records nothing.
# /bin/sh here is dash: a shell killed by a signal it has not trapped runs no EXIT trap at all, so
# without the three signal traps below a `kill`, a timeout wrapper or a supervisor would leak both
# the slot and the container. dash also runs a trap only between commands, so a signal arriving
# during pytest is handled when pytest returns, not the instant it lands (measured, #215).
secret_file=""
container_name=""
suite_green=""
cleanup_ran=""
cleanup() {
    cleanup_status=$?
    [ -z "$cleanup_ran" ] || return $cleanup_status
    cleanup_ran=1
    [ -z "$secret_file" ] || rm -f "$secret_file" || true
    [ -z "$container_name" ] || docker rm -f -v "$container_name" >/dev/null 2>&1 || true
    [ -z "$suite_lock_dir" ] || rmdir "$suite_lock_dir" 2>/dev/null || true
    # The entry names the class it was verified at: a tree green for class C is green for a class-C
    # change, and the next push has to be able to see which question was answered (#215).
    [ -z "$suite_green" ] || tested_tree_record "$change_class" || true
    return $cleanup_status
}
trap 'cleanup; exit 1' INT TERM HUP
trap cleanup EXIT

# Before the postgres container: a broken portal/public/*.js fails here for free, without
# paying the ~2min container-and-migrate cost that the python suite below needs. Class C skips it:
# what it changed in a .js file was proved to be comment lines.
if [ "$change_class" != C ]; then
    printf '→ js\n'
    tool/checks/js
fi

# retrieval: the morphological analyzer (kiwipiepy) analysis/retrieval needs. Without it the BM25
# tests fail wholesale with ModuleNotFoundError, indistinguishable from "the dictionary was not loaded" (#28).
# The same extras in every class: a narrower sync would uninstall them from the shared venv, and the
# next full run would pay to put them back.
uv sync --extra dev --extra retrieval --frozen

if [ "$change_class" != C ] && [ -z "$TEST_POSTGRES_URL" ]; then
    # Every worktree gets its own throwaway container, so channels can run this concurrently. The
    # port comes from the worktree path (cksum is POSIX) rather than a table nobody maintains;
    # COSMAI_TEST_PG_PORT still overrides it (#60 2.10).
    port=${COSMAI_TEST_PG_PORT:-$((55000 + $(pwd -P | cksum | cut -d' ' -f1) % 1000))}
    # Vectors live in a file for now, so no extension is needed. The day this moves to pgvector,
    # change this default to pgvector/pgvector:pg18 (#28 follow-up).
    image=${COSMAI_TEST_PG_IMAGE:-postgres:18-alpine}
    name=cosmai-test-postgres-$port
    # A different container on the same port belongs to another worktree or is a leak: name it and
    # stop, rather than silently sharing or clobbering someone else's database.
    holder=$(docker ps --filter "publish=$port" --format '{{.Names}}' 2>/dev/null | head -1)
    if [ -n "$holder" ] && [ "$holder" != "$name" ]; then
        printf 'port %s is held by container %s (another worktree, or a leak to remove)\n' "$port" "$holder" >&2
        exit 1
    fi
    # Our own leaked container from a killed run goes first, so it is not counted as somebody
    # else's suite, and only then does this run queue for one of the host's three slots.
    # rm -v: removes the postgres image's anonymous volume too (without it every run leaks a ~1GB volume)
    docker rm -f -v "$name" >/dev/null 2>&1 || true
    suite_lock_acquire "$port"
    secret_file=$(mktemp)
    container_name=$name
    docker run -d --rm --name "$name" -e POSTGRES_PASSWORD=fleet -e POSTGRES_USER=fleet \
        -e POSTGRES_DB=fleet --tmpfs /var/lib/postgresql -p "$port":5432 "$image" >/dev/null
    for _ in $(seq 1 60); do
        pg_isready -h localhost -p "$port" -U fleet -q 2>/dev/null && break
        sleep 1
    done
    # Test-only dummy values, not secrets -- matches TEST_POSTGRES_URL/TEST_POSTGRES_RUNTIME_URL below.
    printf 'NEEDS_DB_MIGRATOR=check\nNEEDS_DB_RUNTIME=check-runtime\n' > "$secret_file"
    # Harness only: collectors/commerce owns trend_radar in production, but db/views/collector_health.sql
    # binds to it, so without the real dump here the deploy path below could only be tested by guarding
    # the view into a silent skip -- test green, production missing.
    docker exec -i "$name" psql -U fleet -d fleet -q -v ON_ERROR_STOP=1 \
        < contracts/ddl/current/app.trend_radar.sql
    # Same reason, tubedepth: since #77 the view's youtube arm binds tubedepth.jobs. Only that one
    # table, not the whole dump -- `analyze link` reads four other tubedepth tables, and standing
    # those up here would silently turn test_analyze_all.py's "link fails, so the CLI exits 1" green
    # for the wrong reason. The additive files are the ones that named jobs (#101 started_at/
    # elapsed_ms, #102 dataset); production already has both.
    #
    # #144 adds two more for the same reason: db/views/{mention,collection}_lineage.sql bind
    # tubedepth.comments (the source text behind a youtube mention) and tubedepth.artifacts (the
    # fetch that carried it). Still table-by-table, not the whole dump, so `analyze link`'s four
    # other tubedepth tables stay absent and test_analyze_all.py keeps failing for its own reason.
    #
    # One live consequence to know about: analysis/polarity/pipeline.py's `_exists(conn, youtube_
    # schema, "comments")` now answers true here, so the polarity stage's youtube arm actually runs
    # in this harness instead of being skipped -- over an empty table, so it yields nothing and
    # nothing changes today. A test that starts asserting "the youtube arm did not run" would be
    # asserting the absence of a table, not a behaviour.
    { echo 'CREATE SCHEMA IF NOT EXISTS tubedepth;'
      for t in jobs comments artifacts; do
          sed -n "/^CREATE TABLE tubedepth\.$t (/,/^);\$/p" contracts/ddl/current/app.tubedepth.sql
      done
      cat contracts/ddl/tubedepth/*_jobs_*.sql contracts/ddl/tubedepth/*_comments_*.sql
    } | docker exec -i "$name" psql -U fleet -d fleet -q -v ON_ERROR_STOP=1
    # Run twice: production and the test harness both re-run this on every deploy, so it must be
    # idempotent (test_migrate_ledger_and_grants.py proves the ledger stays at one row per version).
    COSMAI_SECRET_FILE="$secret_file" db/migrate.sh --container "$name" --db fleet --superuser fleet
    # Harness only: the per-test schema fixture needs CREATE on the database.
    docker exec "$name" psql -U fleet -d fleet -q -c 'GRANT CREATE ON DATABASE fleet TO needs_migrator'
    COSMAI_SECRET_FILE="$secret_file" db/migrate.sh --container "$name" --db fleet --superuser fleet
    TEST_POSTGRES_URL="postgresql+psycopg://needs_migrator:check@localhost:$port/fleet"
    TEST_POSTGRES_RUNTIME_URL="postgresql+psycopg://needs_runtime:check-runtime@localhost:$port/fleet"
    export TEST_POSTGRES_URL TEST_POSTGRES_RUNTIME_URL
fi

# Straight to the terminal, colour and stderr intact: nothing reads pytest's output, since what the
# cleanup records is the tree and the time, not a count (#214 review).
# $change_tests is unquoted on purpose: it is a list of paths the classifier produced, one word each.
case "$change_class" in
    C)
        # Nothing executable moved, so what is left to check is the text and the surfaces made of it.
        printf '→ format\n'
        tool/checks/format
        printf '→ lint\n'
        tool/checks/lint
        printf '→ lang\n'
        tool/checks/lang
        if [ -n "$change_tests" ]; then
            printf '→ pytest %s\n' "$change_tests"
            uv run pytest $change_tests
        fi
        ;;
    B)
        # An entry can map to no tests at all (a directory nothing imports), and a bare `uv run
        # pytest` there would collect the whole suite -- the opposite of what this class is for.
        if [ -n "$change_tests" ]; then
            printf '→ pytest %s\n' "$change_tests"
            uv run pytest $change_tests
        fi
        # The whole suite minus the part that needs the database: a package's own tests say the
        # package is right, and this says nothing else in the tree noticed. The marker expression
        # repeats the two the ini file excludes, because -m on the command line replaces it.
        printf '→ pytest (the DB-free suite)\n'
        uv run pytest -m 'not postgres and not live and not local_llm'
        ;;
    *)
        printf '→ pytest\n'
        # The session guards in tests/conftest.py are armed only here: a partial run never registers
        # the default implementations, so outside the full suite they report a failure of their own (#215).
        COSMAI_FULL_SUITE=1 uv run pytest
        ;;
esac
suite_green=1
