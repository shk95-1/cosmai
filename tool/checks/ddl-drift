#!/bin/sh
# Does production still look like the contract says it does?
#
# #10 condition 1 is "re-dump diff = 0 (added columns only where the contract declares them)". That
# sentence has two halves and both need machinery, because a human running pg_dump by hand gets a
# different answer depending on the flags: ownership and ACLs move on their own (db/grants/*.sql
# adds needs_runtime GRANTs on every deploy) and would drown a real column difference in 150 lines
# of noise. So: --no-owner -x, and the \restrict lines pg_dump 18 wraps the file in are stripped
# because they carry a per-dump nonce.
#
# The second half is why this is not a plain diff against contracts/ddl/current/. Those files are a
# BASELINE, not a mirror: contracts/ddl/<schema>/*.sql layer additive changes on top of them, and
# tests/conftest.py builds its throwaway schema the same way (dump, then every additive file). Were
# the baseline re-dumped to include an added column, applying that file again would fail with
# "column already exists" and the fixture would break. Production is therefore compared against
# baseline + additive files, rebuilt here in a throwaway container -- the same composition the tests
# use, so the two can never drift apart silently.
#
# app.needs, the schema this repo owns, is the exception and has its own section at the bottom:
# it has no dump baseline because db/migrate.sh IS its expected state, and production carries
# objects a fork put there whose files are not in this checkout (contracts/ddl/needs/foreign.txt).
#
# Reads nothing secret: pg_dump runs inside the production container as the superuser via docker
# exec, the same access path db/migrate.sh already uses.
set -e
. tool/checks/prerequisite
require_command docker pg_isready

container=${COSMAI_PG_CONTAINER:-cosmai-postgres}
superuser=${COSMAI_PG_SUPERUSER:-platform}
port=${COSMAI_DRIFT_PG_PORT:-55490}
name=cosmai-drift-postgres-$port
work=$(mktemp -d)
trap 'rm -rf "$work"; docker rm -f "$name" >/dev/null 2>&1 || true' EXIT

# Comments carry the server version and the object-name banners; SET lines carry session defaults.
# Neither is schema. Dropping them lets a throwaway postgres:18-alpine be compared with the Debian
# 18.6 production build without the version banner counting as drift.
normalise() {
    grep -v '^--' | grep -v '^\\restrict' | grep -v '^\\unrestrict' \
        | grep -v '^SET ' | grep -v '^SELECT pg_catalog.set_config' | sed '/^$/d'
}

docker rm -f "$name" >/dev/null 2>&1 || true
docker run -d --name "$name" -e POSTGRES_PASSWORD=drift -e POSTGRES_USER=drift \
    -e POSTGRES_DB=drift -p "$port":5432 postgres:18-alpine >/dev/null
for _ in $(seq 1 60); do
    pg_isready -h localhost -p "$port" -U drift -q 2>/dev/null && break
    sleep 1
done

status=0
# One place decides pass/fail, so the needs section below cannot drift from the loop's verdict.
report() { # $1 = db.schema label (also the $work filename), $2 = what expected was built from
    if diff -u "$work/expected.$1" "$work/actual.$1" > "$work/diff.$1"; then
        echo "ddl-drift: $1 matches the contract"
    else
        echo "ddl-drift: $1 DRIFTED -- production is not $2" >&2
        cat "$work/diff.$1" >&2
        status=1
    fi
}

# db:schema pairs, matching the contracts/ddl/current/<db>.<schema>.sql naming.
pairs='app:trend_radar app:tubedepth cosmai:cosmai'

# Everything is built before anything is dumped, and no schema is dropped in between. That is not
# tidiness. pg_dump orders objects by dependency, not by name, so a schema dumped alone sorts
# differently from the same schema dumped beside the views that read it: since #77
# db/views/collector_health.sql reads tubedepth.jobs, and production -- where that view exists --
# hoists jobs to the front of the tubedepth dump, while a lone rebuild leaves it in alphabetical
# place. Building one schema at a time and dropping it after its own dump also left db/migrate.sh
# below with no tubedepth.jobs to bind to, so the view failed and the app.needs verdict vanished
# altogether (#114). Expected is therefore assembled as the whole graph production carries.
for pair in $pairs; do
    db=${pair%%:*}
    schema=${pair#*:}
    baseline=contracts/ddl/current/$db.$schema.sql
    [ -f "$baseline" ] || { echo "ddl-drift: no baseline for $pair" >&2; exit 1; }

    # Expected = baseline, then every additive file the contract declares for that schema.
    docker exec -i "$name" psql -U drift -d drift -X -q -v ON_ERROR_STOP=1 \
        -c 'SET client_min_messages = warning' -f - < "$baseline" > /dev/null
    for add in contracts/ddl/"$schema"/*.sql; do
        [ -e "$add" ] || continue
        docker exec -i "$name" psql -U drift -d drift -X -q -v ON_ERROR_STOP=1 -f - < "$add" > /dev/null
    done
done

# ---------------------------------------------------------------------------------------------
# app.needs is this repo's own schema, so it gets its expected state from the script production
# runs -- db/migrate.sh -- not from a dump baseline. Assembling it from the ledger instead would
# be impossible: needs.schema_migration records the fork's 020, whose file is not in this
# checkout. What the fork put into production is therefore declared, not assembled:
# contracts/ddl/needs/foreign.txt names each object that is theirs -- minus whatever this
# checkout turns out to declare after all, which is the fork's own case (cosmai#108, below).
needs_db=app
foreign=contracts/ddl/needs/foreign.txt
[ -f "$foreign" ] || { echo "ddl-drift: missing $foreign" >&2; exit 1; }

# The loop above already stood up every schema db/views/*.sql binds to, so migrate.sh deploys the
# views here rather than skipping them. The two passwords are throwaway values for this container,
# not secrets. Output is held back rather than passed through: migrate.sh's DROP VIEW IF EXISTS
# prints two NOTICEs on a fresh database, and two stray lines in the middle of four verdicts read
# like a fault.
printf 'NEEDS_DB_MIGRATOR=drift\nNEEDS_DB_RUNTIME=drift-runtime\n' > "$work/needs.env"
COSMAI_SECRET_FILE="$work/needs.env" db/migrate.sh --container "$name" --db drift --superuser drift \
    > /dev/null 2> "$work/migrate.err" || { cat "$work/migrate.err" >&2; exit 1; }

# Which of $foreign's entries are really someone else's is decided by the checkout, not by the
# list: the same nine lines mean the opposite in the fork, which declares 020~025 and their views
# itself (cosmai#108). The needs schema migrate.sh just built IS this checkout's declaration, so
# the question goes to pg_catalog rather than to a second parser of the same .sql files -- views
# and ADD COLUMNs fall out of it for free. tool/ddl-foreign-entries applies the rule and rejects a
# malformed entry; that entry check moved here from before the container so that the whole rule
# lives in one file, and the cost is that a typo is caught a migrate.sh later than it used to be.
#
# pg_class/pg_attribute, not information_schema: the information_schema views filter by what the
# current role may see, so a role with fewer grants would report fewer declared objects, and every
# object that fell out would be *excluded* from the comparison instead of ignored -- the failure
# direction that makes the check quietly smaller. pg_catalog does no such filtering. The emptiness
# guard below catches the all-or-nothing version of the same accident.
docker exec "$name" psql -U drift -d drift -X -Atq \
    -c "SELECT c.relname FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
         WHERE n.nspname = 'needs' AND c.relkind IN ('r', 'p', 'v', 'm')
        UNION ALL
        SELECT c.relname || '.' || a.attname FROM pg_class c
          JOIN pg_namespace n ON n.oid = c.relnamespace
          JOIN pg_attribute a ON a.attrelid = c.oid
         WHERE n.nspname = 'needs' AND c.relkind IN ('r', 'p', 'v', 'm')
           AND a.attnum > 0 AND NOT a.attisdropped" > "$work/declared"
# A query that succeeds and returns nothing would ignore nothing, exclude all nine, and still let
# report() print "matches the contract" -- the check disappearing without a word. migrate.sh ran a
# few lines up, so an empty needs schema here is a fault, never a state. The same guard sits in
# tool/ddl-foreign-entries (where the suite can re-ask it); this one names the query that failed.
[ -s "$work/declared" ] || { echo "ddl-drift: the declared-object query came back empty" >&2; exit 1; }
tool/ddl-foreign-entries "$foreign" "$work/declared" > "$work/foreign"

exclude=
drop_columns=
while read -r kind object; do
    case $kind in
        table) exclude="$exclude -T needs.$object" ;;
        column) drop_columns="$drop_columns $object" ;;
    esac
done < "$work/foreign"

# ---------------------------------------------------------------------------------------------
# Expected: all four off the finished graph, before anything is torn down for the needs replay.
for pair in $pairs; do
    db=${pair%%:*}
    schema=${pair#*:}
    docker exec "$name" pg_dump -U drift -d drift --schema-only --no-owner -x -n "$schema" \
        | normalise > "$work/expected.$db.$schema"
done
# needs's expected takes the same dump-restore-dump round trip its actual takes below, because
# pg_dump's deparse is not a fixed point: a view body written by CREATE VIEW and the same body
# after a dump and restore print differently -- ANY ((ARRAY[...])::text[]) comes back as
# ANY (ARRAY[(...)::text, ...]). Comparing a once-deparsed expected against a twice-deparsed
# actual reported every such view as drift forever, and app.needs stayed red for a reason that
# had nothing to do with production (#120). The three pairs above need none of this: both of
# their sides come off a single pg_dump.
docker exec "$name" pg_dump -U drift -d drift --schema-only --no-owner -x -n needs \
    > "$work/expected.needs.sql"
docker exec "$name" psql -U drift -d drift -X -q -c 'SET client_min_messages = warning' \
    -c 'DROP SCHEMA needs CASCADE' > /dev/null
docker exec -i "$name" psql -U drift -d drift -X -q -v ON_ERROR_STOP=1 \
    -c 'SET client_min_messages = warning' -f - < "$work/expected.needs.sql" > /dev/null
docker exec "$name" pg_dump -U drift -d drift --schema-only --no-owner -x -n needs \
    | normalise > "$work/expected.$needs_db.needs"

# Actual: the three schemas this repo does not own come straight off production.
for pair in $pairs; do
    db=${pair%%:*}
    schema=${pair#*:}
    docker exec "$container" pg_dump -U "$superuser" -d "$db" --schema-only --no-owner -x -n "$schema" \
        | normalise > "$work/actual.$db.$schema"

    report "$db.$schema" "baseline + declared additive files"
done

# pg_dump can exclude a table but not a column, so production's needs is replayed into the
# throwaway (where the expected schema is dropped first) and the foreign columns are dropped
# there. Both sides then come off the same pg_dump against the same server version -- and the
# replay lands beside the same trend_radar and tubedepth the expected dump was taken next to,
# so the views it recreates sort the way they did a moment ago.
docker exec "$name" psql -U drift -d drift -X -q -c 'SET client_min_messages = warning' \
    -c 'DROP SCHEMA needs CASCADE' > /dev/null
# shellcheck disable=SC2086 # $exclude is a built list of -T flags, and must word-split.
docker exec "$container" pg_dump -U "$superuser" -d "$needs_db" --schema-only --no-owner -x -n needs \
    $exclude > "$work/production.needs.sql"
docker exec -i "$name" psql -U drift -d drift -X -q -v ON_ERROR_STOP=1 \
    -c 'SET client_min_messages = warning' -f - < "$work/production.needs.sql" > /dev/null
for object in $drop_columns; do
    docker exec "$name" psql -U drift -d drift -X -q -v ON_ERROR_STOP=1 \
        -c "ALTER TABLE needs.${object%.*} DROP COLUMN ${object#*.}" > /dev/null
done
docker exec "$name" pg_dump -U drift -d drift --schema-only --no-owner -x -n needs \
    | normalise > "$work/actual.$needs_db.needs"

report "$needs_db.needs" "db/migrate.sh + the objects $foreign declares as someone else's and this checkout does not"

exit $status
