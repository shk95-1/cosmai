#!/bin/sh
# #175: a bare `Closes #n` in an upstream commit re-resolves against whichever repo receives the
# merge, so once a fork merges upstream it can close an unrelated fork issue with the same number.
# The hook (`.githooks/commit-msg`) stops NEW bare closes; this finds damage from OLD ones already
# on upstream main. Run it in the fork clone after merging upstream, before closing the merge issue:
#   tool/checks/foreign-closes shk95/cosmai-import-ydc upstream
#
# Usage: tool/checks/foreign-closes <this-repo owner/repo> <other-repo remote name>
#
# #190: the same collision the other direction -- a PR about to MERGE INTO this repo can carry
# bare `Closes #n` commits meant for some other repo, closing this repo's issues by accident.
# --predict answers it BEFORE the merge instead of finding the damage after:
#   tool/checks/foreign-closes <owner/repo> --predict <ref>

repo=$1
mode=$2
if [ -z "$repo" ]; then
  printf 'usage: %s <owner/repo> <remote>\n' "$0" >&2
  printf '       %s <owner/repo> --predict <ref>\n' "$0" >&2
  exit 2
fi

if [ "$mode" = "--predict" ]; then
  ref=$3
  if [ -z "$ref" ]; then
    printf 'usage: %s <owner/repo> --predict <ref>\n' "$0" >&2
    exit 2
  fi

  open_file=$(mktemp)
  pairs_file=$(mktemp)
  commits_file=$(mktemp)
  err_file=$(mktemp)
  trap 'rm -f "$open_file" "$pairs_file" "$commits_file" "$err_file"' EXIT

  if ! gh api --paginate "repos/$repo/issues?state=open&per_page=100" 2>"$err_file" \
      | jq -s 'add | map(select(.pull_request == null)) | sort_by(.number)' > "$open_file"; then
    printf 'gh api failed listing open issues for %s: %s\n' "$repo" "$(cat "$err_file")" >&2
    exit 2
  fi
  if ! jq -e 'type == "array"' "$open_file" >/dev/null 2>&1; then
    printf 'jq failed to read the open-issues response for %s (not the expected array shape)\n' "$repo" >&2
    exit 2
  fi

  # sha on its own line, then the full message, then a NUL record terminator -- the NUL lets a
  # commit body containing blank lines (nearly all of them) stay one awk record.
  git log --format='%H%n%B%x00' "HEAD..$ref" > "$commits_file"

  # GitHub only treats a keyword as a closing directive when nothing but the ref list follows it
  # on the line -- "fix(scope): #40 does X" starts with the Conventional Commits type "fix" too,
  # but is prose, not "Fixes #40" (found live against PR #59: d8354de false-positived on #40
  # before this anchor was added). "owner/repo#n" survives a merge unchanged, so it is excluded.
  awk -v RS='\0' '
    {
      rec = $0
      sub(/^\n/, "", rec)
      nl = index(rec, "\n")
      if (nl == 0) { next }
      sha = substr(rec, 1, nl - 1)
      body = substr(rec, nl + 1)
      m = split(body, lines, "\n")
      for (i = 1; i <= m; i++) {
        line = lines[i]
        gsub(/^[ \t]+|[ \t]+$/, "", line)
        low = tolower(line)
        if (match(low, /^(close[sd]?|fix(e[sd])?|resolve[sd]?):?[ \t]+(([a-z0-9_.-]+\/[a-z0-9_.-]+)?#[0-9]+([ \t]*,[ \t]*|[ \t]+and[ \t]+)?)+$/)) {
          match(low, /^(close[sd]?|fix(e[sd])?|resolve[sd]?):?[ \t]+/)
          stripped = substr(line, RLENGTH + 1)
          gsub(/[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+#[0-9]+/, "", stripped)
          while (match(stripped, /#[0-9]+/)) {
            print sha, substr(stripped, RSTART + 1, RLENGTH - 1)
            stripped = substr(stripped, RSTART + RLENGTH)
          }
        }
      }
    }
  ' "$commits_file" > "$pairs_file"

  hit=0
  while IFS= read -r issue; do
    [ -z "$issue" ] && continue
    n=$(printf '%s' "$issue" | jq -r '.number')
    title=$(printf '%s' "$issue" | jq -r '.title')
    shas=$(awk -v n="$n" '$2 == n { print substr($1, 1, 7) }' "$pairs_file" | awk '!seen[$0]++')
    [ -z "$shas" ] && continue
    hit=1
    # paste -sd with a multi-char delimiter cycles through its characters one per line rather than
    # repeating the whole string, so ", " is built explicitly instead (caught live against #59:
    # `paste -sd ', ' -` alternated ',' and ' ' and produced "d8354de,7054e16 d43a976").
    list=$(printf '%s\n' "$shas" | awk 'NR==1 { printf "%s", $0; next } { printf ", %s", $0 } END { print "" }')
    printf '#%s · %s · closing commits %s\n' "$n" "$title" "$list"
  done <<EOF
$(jq -c '.[]' "$open_file")
EOF

  exit $hit
fi

remote=$mode
if [ -z "$remote" ]; then
  printf 'usage: %s <owner/repo> <remote>\n' "$0" >&2
  exit 2
fi

issues_file=$(mktemp)
items_file=$(mktemp)
out_file=$(mktemp)
err_file=$(mktemp)
trap 'rm -f "$issues_file" "$items_file" "$out_file" "$err_file"' EXIT

# --paginate: closed-issue counts regularly exceed one page (100) in this repo, and a script whose
# whole purpose is finding already-merged damage must not silently look at only the newest page
# (#175 review, should-fix 3). --paginate concatenates each page's JSON array back to back, so the
# pages are re-joined into one array before jq reads it.
if ! gh api --paginate "repos/$repo/issues?state=closed&per_page=100" 2>"$err_file" \
    | jq -s 'add' > "$issues_file"; then
  printf 'gh api failed listing closed issues for %s: %s\n' "$repo" "$(cat "$err_file")" >&2
  exit 2
fi
if ! jq -c '.[] | {number, title}' "$issues_file" > "$items_file"; then
  printf 'jq failed to read the closed-issues response for %s (not the expected array shape)\n' "$repo" >&2
  exit 2
fi

while IFS= read -r item; do
  [ -z "$item" ] && continue
  n=$(printf '%s' "$item" | jq -r '.number')
  title=$(printf '%s' "$item" | jq -r '.title')
  if ! timeline=$(gh api "repos/$repo/issues/$n/timeline" 2>"$err_file"); then
    printf 'gh api failed reading timeline for %s#%s: %s\n' "$repo" "$n" "$(cat "$err_file")" >&2
    exit 2
  fi
  commit=$(printf '%s' "$timeline" | jq -r '[.[] | select(.event == "closed") | .commit_id] | last // empty')
  [ -z "$commit" ] && continue
  git merge-base --is-ancestor "$commit" "$remote/main" 2>/dev/null
  ancestor_status=$?
  if [ "$ancestor_status" -eq 128 ]; then
    # Not exactly "clean" or "foreign" -- the commit isn't reachable at all here (not fetched).
    printf 'warning: %s#%s: %s not found locally; fetch %s and re-run to check it\n' \
      "$repo" "$n" "$commit" "$remote" >&2
    continue
  fi
  if [ "$ancestor_status" -eq 0 ]; then
    short=$(printf '%s' "$commit" | cut -c1-7)
    printf '#%s · %s · closed by %s\n' "$n" "$title" "$short" >> "$out_file"
  fi
done < "$items_file"

if [ -s "$out_file" ]; then
  cat "$out_file"
  exit 1
fi
exit 0
