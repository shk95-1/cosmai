#!/bin/sh
# The repository operates in English (#192 D12), so a Hangul line in a tracked file is a regression
# the moment it is staged. Only staged additions are examined, like tool/checks/paths: history is
# not this check's business, and the migration itself has to be able to delete Korean.
#
# `--range <base>` reads `<base>...HEAD` instead of the index, for the one caller that has no index to
# read: the push gate's prose class, where nothing is staged and the staged form passes vacuously --
# the check the class exists to run measuring nothing at all (#215 review I3).
set -e

lang_range="--cached"
if [ "$1" = "--range" ]; then
    if [ -z "$2" ]; then
        printf 'usage: tool/checks/lang [--range <base>]\n' >&2
        exit 2
    fi
    lang_range="$2...HEAD"
elif [ -n "$1" ]; then
    printf 'usage: tool/checks/lang [--range <base>]\n' >&2
    exit 2
fi

# Codepoints rather than a literal 가-힣 range: outside a UTF-8 locale grep reads such a range as
# bytes and then every multibyte character matches, which would fail on Japanese product names.
HANGUL='[\x{1100}-\x{11FF}\x{3130}-\x{318F}\x{A960}-\x{A97F}\x{AC00}-\x{D7A3}\x{FFA0}-\x{FFDC}]'

# A grep without -P would find nothing and this check would pass everything in silence, which is
# indistinguishable from a clean commit. Prove the detector sees Hangul before trusting a pass.
printf '\355\225\234\n' | grep -qP "$HANGUL" || {
    printf '\n✗ tool/checks/lang: this grep has no -P, so the Korean check cannot run.\n\n' >&2
    exit 1
}

# Korean that is content rather than operating surface stays. Each entry leaves as a later wave of
# #192 removes its reason, so the list is here rather than spread across the tree.
# A fixture directory is named twice because git's default pathspec matching gives `**` no empty
# match: `tests/**/fixtures/` needs a segment in between and would miss `tests/fixtures/`.
# Unquoted on purpose: one word, either --cached or a revision range.
hits=$(git diff $lang_range -U0 --no-color -- . \
    ':!tool/checks/lang' \
    ':!README.ko.md' \
    ':!eval/' \
    ':!db/seed/' \
    ':!analysis/**/*.csv' \
    ':!portal/public/app.js' \
    ':!portal/public/index.html' \
    ':!portal/public/lineage.js' \
    ':!portal/public/map-app.js' \
    ':!portal/public/map.html' \
    ':!portal/public/ops-app.js' \
    ':!portal/public/ops.html' \
    ':!portal/public/ops.js' \
    ':!portal/public/query.js' \
    ':!portal/public/render.js' \
    ':!portal/public/screens.js' \
    ':!portal/public/style.css' \
    ':!tests/fixtures/**' \
    ':!tests/golden*/**' \
    ':!tests/**/fixtures/**' \
    ':!tests/**/golden*/**' \
    | awk '/^\+\+\+ /{ f = substr($0, 7); next } /^\+[^+]/ { print f ": " substr($0, 2) }' \
    | grep -P "$HANGUL" || true)
[ -z "$hits" ] && exit 0
printf '%s\n' "$hits" >&2
printf '\n✗ An added line is in Korean. The tools and the repository operate in English (#192).\n' >&2
printf '  Korean that is data (seed rows, evaluation sets, UI strings) belongs on the allowlist in\n' >&2
printf '  tool/checks/lang; Korean a test needs belongs under a tests/**/fixtures/ directory.\n\n' >&2
exit 1
