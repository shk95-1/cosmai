# origin: this repository (#214).
# reuse: source it from a hook or a check; it is the one place that knows where a green run is kept.
#
# What the suite proves is a tree, not a push: the same tree pushed again -- the worker's own push,
# the coordinator's merge carrying that identical tree, the wave branch -- has nothing new to check.
# The record lives under the common git directory, so every worktree of one clone shares it and no
# entry can ever be committed.
#
# To re-arm the gate for a tree the cache already calls green, push once with COSMAI_FORCE_SUITE=1;
# deleting the file under <common git dir>/cosmai-tested/ is the permanent form of the same thing.
# AGENTS.md forbids --no-verify, so those two are the sanctioned escapes.

tested_tree_dir() {
    printf '%s/cosmai-tested\n' "$(git rev-parse --git-common-dir)"
}

tested_tree_forced() {
    [ "${COSMAI_FORCE_SUITE:-0}" = 1 ]
}

# Prints the "<UTC>" a tree was proved green at; nothing for a tree that never was, and nothing at
# all while the run is forced, so one push can re-verify what the cache claims.
tested_tree_stamp() {
    if tested_tree_forced; then
        return 0
    fi
    cat "$(tested_tree_dir)/$1" 2>/dev/null || true
}

# A ≥ B ≥ C: a run that answered a bigger question answers a smaller one, never the other way round
# (#215 review C2). An entry that names no class -- one written before the class was recorded, or by
# a caller that named none -- proves nothing about any class and ranks below all of them.
tested_tree_rank() {
    case "$1" in
        A) printf '3\n' ;;
        B) printf '2\n' ;;
        C) printf '1\n' ;;
        *) printf '0\n' ;;
    esac
}

# The class out of an entry line ("<UTC> class B" -> "B"), empty when the entry names none.
tested_tree_class() {
    case "$1" in
        *' class '*) printf '%s\n' "${1##* class }" ;;
        *) printf '\n' ;;
    esac
}

# Captured before the suite starts. Read at the end instead, it would stamp whatever HEAD became
# during seventeen minutes of testing -- a rebase, a checkout -- and certify a tree nothing ever ran
# against. Uncommitted changes are refused for the same reason: what was tested is not what HEAD is,
# and the everyday flow is to run the suite and then commit.
tested_tree_capture() {
    tested_tree_captured=""
    if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
        printf 'tested-tree: the checkout has uncommitted changes; this run will not be recorded\n'
        return 0
    fi
    tested_tree_captured=$(git rev-parse "HEAD^{tree}" 2>/dev/null) || tested_tree_captured=""
}

# Records the tree the suite actually ran against, and -- when the caller names one -- the risk class
# it was verified at (#215): a tree green for class C was asked a smaller question than one green for
# class A, and the entry has to say which. The caller reaches this only after a green run and after
# the container is gone, so a failed or killed run leaves no claim behind.
tested_tree_record() {
    [ -n "$tested_tree_captured" ] || return 0
    tested_tree_now=$(git rev-parse "HEAD^{tree}" 2>/dev/null) || tested_tree_now=""
    if [ "$tested_tree_now" != "$tested_tree_captured" ]; then
        printf 'tested-tree: HEAD moved during the run; this run will not be recorded\n'
        return 0
    fi
    # Asked a second time, because HEAD's tree is the same object whether the working files still
    # match it or not: an edit made while the suite ran leaves a checkout nothing was tested against.
    if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
        printf 'tested-tree: the checkout became dirty during the run; this run will not be recorded\n'
        return 0
    fi
    tested_tree_where=$(tested_tree_dir)
    mkdir -p "$tested_tree_where"
    printf '%s%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${1:+ class $1}" \
        > "$tested_tree_where/$tested_tree_captured"
}
