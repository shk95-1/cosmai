#!/bin/sh
# A bare marker is a plan living outside the issue ledger. The accepted shape is the marker of a
# `when-touched` issue, TODO(#n) or, once two repos share one history, TODO(owner/repo#n) (#238,
# the same call #175 made for `Closes #n`) -- tool/issue audit checks at boot that n is open in the
# named repo, the shape is what an offline hook can enforce, the linkage is not.
#
# `--tree` reads every tracked file instead of the index, for the caller with neither: `tool/checks/test`
# runs this in every change class, and CI runs that gate bare -- class A, no `--changed`, so there is
# no index staged and no base to diff against (#281). Until then this check's only caller was the
# pre-commit hook, which a clone that never set core.hooksPath does not have at all.
set -e

todo_usage() {
    printf 'usage: tool/checks/todo [--tree]\n' >&2
    exit 2
}

# Loose on purpose, as the bare-only version before it was: this also has to let through the
# check's own regex source (tool/issue's git-grep pattern), which contains "TODO(" followed by
# metacharacters rather than a real issue number. That line is the one hit the tree form reads on
# this tree, and it is why the looseness is now load-bearing rather than incidental (#281).
if [ "$1" = "--tree" ]; then
    hits=$(git grep -I -n -E 'TODO' -- . ':!tool/checks/todo' \
        | grep -vE 'TODO\\*\(?([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)?#' || true)
    subject="A tracked marker"
elif [ -n "$1" ]; then
    todo_usage
else
    hits=$(git diff --cached -U0 --no-color -- . ':!tool/checks/todo' | grep -E '^\+[^+]' | grep -E 'TODO' \
        | grep -vE 'TODO\\*\(?([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)?#' || true)
    subject="A staged marker"
fi
[ -z "$hits" ] && exit 0
printf '%s\n' "$hits" >&2
printf '\n✗ %s has no issue: write TODO(#n) or TODO(owner/repo#n) and open a when-touched issue for n.\n\n' \
    "$subject" >&2
exit 1
