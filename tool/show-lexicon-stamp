#!/usr/bin/env python3
"""Prints in one line which version the topic dictionary is (fork #62).

`cosmai retrieval eval` 이 행마다 `dictionary` 열에 싣는 것과 **같은 문자열**이다 -- 계약
(`contracts/interfaces.md` §검색 실측)이 적어 둔 사전 판본을 다시 확인하는 길이고,
`tool/show-vector-stamp` 가 벡터 축에서 하는 일과 같은 자리다. 문자열을 여기서 따로 지으면 계약이
인용한 판본과 행이 적은 판본이 조용히 갈린다.

Given `--against` it also says **on which axis** the two versions diverge. The fingerprint says only
that they diverged and `cosmai lexicon diff` is row-wise, so it cannot see a changed alias order within
one topic at all -- retracing the dictionary that six lines stood on is the comparison on this axis (a
frozen copy and a load source diverge by the order of a column matching does not look at).

    tool/show-lexicon-stamp                                             # the active version
    tool/show-lexicon-stamp --version 2 --against 3
    tool/show-lexicon-stamp --csv analysis/retrieval/dict/topics_v1.csv --against 3

종료 코드: 0 판본을 찍었다 · 2 막힘(활성 사전 없음 · 그 버전에 행이 없음 · CSV 를 읽을 수 없음 ·
--version 과 --csv 를 함께 줌 -- `contracts/entrypoints.md` §검색 의 blocked 와 같은 자리다).
**갈렸다는 것은 답이지 막힘이 아니다** -- 1 이 설 자리가 없다.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from analysis.retrieval import topics  # noqa: E402


def csv_dictionary(path: Path) -> topics.Topics:
    """One load-source CSV. It takes the same conversion `cosmai lexicon load` uses but **does not stand
    it up in the process** -- this tool only prints the version, it does not change the dictionary. The
    version is None: the number tag is given by the load."""
    from cosmai.cli import _csv_rows
    from db.lexicon import ASPECT_COLUMNS

    at = [ASPECT_COLUMNS.index(column) for column in ("aspect", "pattern", "extra")]
    rows = _csv_rows("aspect", str(path))
    return topics.from_rows([(str(row[at[0]]), str(row[at[1]]), row[at[2]]) for row in rows], None)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("--version", type=int, default=None, help="This version. Default is the active one.")
    parser.add_argument("--csv", default=None, help="The version of this load-source CSV instead of the DB.")
    parser.add_argument("--against", type=int, default=None, help="The DB version to compare with.")
    parser.add_argument("--url", default=None, help="SQLAlchemy URL; default is needs_runtime.")
    args = parser.parse_args(argv)

    if args.csv and args.version is not None:
        # If both say which version it is, there are two answers (the same place as `cosmai lexicon diff`).
        print("--version and --csv cannot be given together", file=sys.stderr)
        return 2

    from cosmai.cli import _connect

    try:
        if args.csv:
            subject = csv_dictionary(Path(args.csv))
            other = None
            if args.against is not None:
                with _connect(args.url) as conn:
                    other = topics.load(conn, version=args.against)
        else:
            with _connect(args.url) as conn:
                subject = topics.load(conn, version=args.version)
                other = None if args.against is None else topics.load(conn, version=args.against)
    # Neither a dictionary that is not there yet nor a CSV that cannot be read is a failure; both are
    # blocked -- the same place as a missing vector store, and NoDictionary even says what to run.
    except (topics.NoDictionary, OSError, ValueError, LookupError) as blocked:
        print(blocked, file=sys.stderr)
        return 2

    print(subject.stamp)
    if other is None:
        return 0
    print(other.stamp)
    lines = topics.differences(subject, other)
    print("\n".join(lines) if lines else "차이 없다")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
