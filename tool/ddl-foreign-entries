#!/bin/sh
# Prints only the entries of contracts/ddl/needs/foreign.txt that are "really foreign" (#75, cosmai#108).
#
# usage: tool/ddl-foreign-entries <foreign.txt> <declared-objects-file>
#   declared-objects-file: the needs objects this checkout declares, one per line.
#     <table>           table or view
#     <table>.<column>  column
# stdout: the surviving entries, one per line -- `table <name>` or `column <table>.<column>`.
#
# Why the list is filtered rather than used as it is: the same file means opposite things in the two
# repos. Upstream all nine lines are foreign objects the fork put into production, but the fork
# cosmai-import-ydc checkout has 020~025 and db/views/, so those same nine are its own declarations.
# So the verdict is asked of the checkout rather than of the list -- an object this checkout declares
# is ignored (not excluded, compared as it is) and only the rest are excluded.
#
# Ignoring does not weaken the check. Excluding means "drop it from the production dump and from the
# expectation too", so excluding one of our objects hides its drift forever -- ignoring is the
# opposite: it keeps an object that stands in the expectation in the production dump as well, so the
# two are still compared. Declare both and both drifts are visible.
# In an upstream checkout none of the nine is in the declaration list, so no entry is caught -- the
# same list comes out in the same order as before this rule existed (tests/tool/test_ddl_drift_foreign.py).
set -e

foreign=$1
declared=$2
[ -n "$foreign" ] && [ -n "$declared" ] || { echo "usage: $0 <foreign.txt> <declared-objects-file>" >&2; exit 2; }
[ -f "$foreign" ] || { echo "ddl-foreign-entries: missing $foreign" >&2; exit 1; }
[ -f "$declared" ] || { echo "ddl-foreign-entries: missing $declared" >&2; exit 1; }
# This rule fails towards "ignore less" = "exclude more", which is silent: when the declaration list
# is empty all nine survive and are all excluded, and the check stamps green while it quietly shrank.
# An empty list is a fault, not a state -- no checkout declares none of its own schema. Stop here.
[ -s "$declared" ] || { echo "ddl-foreign-entries: empty declared-object list in $declared" >&2; exit 1; }

for object in $(sed 's/#.*//' "$foreign" | awk 'NF {print $1}'); do
    # This name is baked into pg_dump flags and ALTER TABLE statements as it is. Anything but a plain
    # identifier (or identifier.identifier) is a typo at best.
    case $object in
        *[!a-z0-9_.]* | *..* | .* | *.) echo "ddl-foreign-entries: bad entry in $foreign: $object" >&2; exit 1 ;;
        *.*.*) echo "ddl-foreign-entries: bad entry in $foreign: $object" >&2; exit 1 ;;
    esac
    # grep -x: so names sharing a prefix (corpus_document and corpus_document_id) do not ignore each other.
    grep -qxF "$object" "$declared" && continue
    case $object in
        *.*) echo "column $object" ;;
        *) echo "table $object" ;;
    esac
done
