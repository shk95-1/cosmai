#!/usr/bin/env python3
"""Re-measures the numbers the contract's §Query routing quotes, over our own dictionary (fork #47).

What ydc `v0.3.0` measured -- the first router used the **Kiwi tokenizer dictionary** as its ingredient
list, and 7 of 10 natural-language queries went to BM25 -- is reproduced here on our dictionary. We keep
the same dictionary in the same place (`DICTIONARIES` in `analysis/retrieval/bm25.py`).

**The measuring rule is exactly ydc's first edition.** With an exact signal (a surface caught by the
ingredient list) it is `bm25`, without one `vector`.
자연어 판정도 ydc 와 같이 Kiwi 의 서술어 태그(`VA`·`VV`·`EF`·`EC`·`VCP`·`VCN`)로 한다 -- 길이로는 안
갈린다(`백탁이 심해요` 는 12자인데 문장이고 `에칠헥실트리아존` 은 9자인데 낱말이다). **오라우팅**은
자연어인데 `bm25` 로 간 것이다.

**A rule makes the sample; a person does not pick it.** In the topic order of the active topic
dictionary, each topic's first `ko` alias is put into the ten fixed frames in turn. Sample 10 = the
first 10 topics, and the number over all 15 topics is given alongside. The frames must emit no
ingredient signal at all (`frame_signals`), or else the rate comes from the frames.

**비율은 이 실측의 답이 아니다.** 비율은 표본의 주제 구성이 정한다 -- 앞 10주제에 `선크림` 주제가 안
들어가고(사전에서 15번째다) 넣으면 오른다. 답은 `ko_in_dictionary` 다: 사람이 쓰는 말 몇 개가 성분 신호로
서는가. 그것은 표본과 무관한 사전의 성질이고, 그 말이 든 자연어 질의는 전부 `bm25` 로 간다.

The canonical topic dictionary is the active version of `needs.aspect_lexicon`, but this tool uses no
DB and stands the load-source CSV up in the process as it is -- exactly the path
`tests/retrieval/conftest.py` uses for the units that have no DB.

    tool/measure-query-routing              # the human-readable form
    tool/measure-query-routing --json       # the form the tests read
"""

from __future__ import annotations

import argparse
import csv
import json
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from analysis.retrieval import bm25, topics  # noqa: E402

INGREDIENTS = bm25.DICT_DIR / "ingredient_dictionary.tsv"
CATALOGUE = ROOT / "eval" / "lexicon" / "ingredient_kr_colloquial_v1.csv"
BRANDS = ROOT / "eval" / "lexicon" / "brand_lexicon_v1.csv"
SAMPLE = 10
# `SPF_PA` from ydc `router.py`. It looks for the surface as it is, so there is no room for natural language.
SPF_PA = re.compile(r"SPF\s*\d{1,3}\+?|PA\s*\+{1,4}", re.IGNORECASE)
# `is_natural` from ydc `router.py`. With an ending or a predicate it is a sentence.
NATURAL_TAGS = frozenset({"VA", "VV", "EF", "EC", "VCP", "VCN"})
# Ten questions that still make sense whatever topic word is swapped in. None may emit an ingredient
# signal -- the tool checks that every time.
FRAMES = (
    "{alias} 관련해서 소비자들이 뭐라고 해",
    "{alias} 어떤지 알려줘",
    "{alias} 얘기 많이 나오나요",
    "{alias} 쪽은 다들 어떻게 보세요",
    "{alias} 신경 쓰이는데 괜찮을까요",
    "{alias} 이거 실제로 어때요",
    "{alias} 때문에 찾아보고 있어요",
    "{alias} 관해서 궁금한 게 있어요",
    "{alias} 있는 거 추천해 주세요",
    "{alias} 어떻게 골라야 하나요",
)
# The three ydc published, down to the surfaces in `rag/README.md` and commit `2146d1b`. Ours must be
# the same letter for letter.
PUBLISHED = ("선크림 루틴 알려줘", "백탁 관련해서 소비자들이 뭐라고 해", "끈적이지 않는 선크림 추천")


def install_topics() -> topics.Topics:
    """The load-source CSV as the active dictionary. It takes exactly the conversion `cosmai lexicon load`
    uses -- writing the dictionary out by hand would make it two copies from that moment, and the
    measurement would be measuring its own copy."""
    from cosmai.cli import _csv_rows
    from db.lexicon import ASPECT_COLUMNS

    aspect, pattern, extra = (ASPECT_COLUMNS.index(column) for column in ("aspect", "pattern", "extra"))
    rows = _csv_rows("aspect", str(topics.DICTIONARY_CSV))
    return topics.use(topics.from_rows([(str(r[aspect]), str(r[pattern]), r[extra]) for r in rows], 1))


def vocabulary() -> list[str]:
    """The file a router would mistake for an "ingredient list". Scanned **longest surface first**
    (ydc `Router._find`)."""
    lines = INGREDIENTS.read_text(encoding="utf-8").splitlines()
    found = {line.split("\t")[0] for line in lines if line.strip() and not line.startswith("#")}
    return sorted(found, key=len, reverse=True)


def matched(query: str, vocab: list[str]) -> list[str]:
    """A found position is erased -- without that, substrings overlap and are counted twice (exactly ydc
    `Router._find`)."""
    found, rest = [], query
    for term in vocab:
        if term in rest:
            found.append(term)
            rest = rest.replace(term, " ")
    return found


def is_natural(query: str) -> bool:
    tags = {token.tag.split("-")[0] for token in bm25.kiwi().tokenize(query)}
    return bool(tags & NATURAL_TAGS)


def route(query: str, vocab: list[str]) -> dict:
    hits = matched(query, vocab)
    natural = is_natural(query)
    return {
        "query": query,
        "natural": natural,
        "hits": hits,
        "route": "bm25" if hits else "vector",
        "misrouted": natural and bool(hits),
    }


def sample(dictionary: topics.Topics, vocab: list[str]) -> dict:
    """Topic order × the topic's first `ko` alias × frame. Having no place to choose is the property of
    this sample."""
    rows = []
    for position, entry in enumerate(dictionary.entries):
        frame = FRAMES[position % len(FRAMES)]
        rows.append({"topic": entry["topic"], **route(frame.format(alias=entry["ko"][0]), vocab)})
    # The frames alone are routed separately. If even one is caught here, the rate came from the frames
    # rather than from the topic words.
    empty = sum(len(matched(frame.format(alias=" "), vocab)) for frame in FRAMES)
    return {
        "size": SAMPLE,
        "misrouted": sum(1 for row in rows[:SAMPLE] if row["misrouted"]),
        "topics": len(rows),
        "topic_misrouted": sum(1 for row in rows if row["misrouted"]),
        "frame_signals": empty,
        "rows": rows,
    }


def dictionary_shape(dictionary: topics.Topics, vocab: list[str]) -> dict:
    """A number independent of the sample -- the answer of this section is here."""
    present = set(vocab)
    people = {alias for entry in dictionary.entries for alias in entry["ko"]}
    inci = {alias for entry in dictionary.entries for alias in entry["mfds_inci"]}
    return {
        "surfaces": len(vocab),
        "ko_aliases": len(people),
        "ko_in_dictionary": len(people & present),
        "ko_caught": sorted(people & present),
        "inci_surfaces": len(inci),
        "inci_in_dictionary": len(inci & present),
        # 성분이면서 담론어인 자리 -- 이진 라우팅으로 안 갈린다 (ydc 의 `콜라겐`).
        "inci_also_asked_with": sorted(inci & people),
    }


def brand_only(dictionary: topics.Topics) -> dict:
    """**What a router without the ingredient-name axis actually does.** A router that looks only at the
    two open signals (brand surfaces · the SPF/PA regex) is run over our only measured query workload --
    the `ko` aliases of the active topic dictionary.
    The queries the literal mode of `interfaces.md` §Retrieval measurements measures are those aliases.

    This number stops the objection that a partial router is **merely incomplete, not harmful**: with 0
    queries sent correctly and nothing but misroutes left, that router is worse than the default. Many
    brand surfaces are short (a fair number are two characters or fewer), so under ydc's substring
    `_find` they catch ordinary Korean."""
    from db.seed.lexicon import _brand_rows

    rows = _brand_rows(ROOT / "eval")
    surface = 2
    marks = {str(row[surface]) for row in rows}
    vocab = sorted(marks, key=len, reverse=True)
    queries = sorted({alias for entry in dictionary.entries for alias in entry["ko"]})
    caught = {
        query: matched(query, vocab) for query in queries if matched(query, vocab) or SPF_PA.findall(query)
    }
    return {
        "queries": len(queries),
        # A topic alias is not a brand name, so everything caught here is a false positive.
        "misrouted": len(caught),
        "correct": 0,
        "traces": caught,
        "rows": len(rows),
        "surfaces": len(marks),
        "short_surfaces": sum(1 for mark in marks if len(mark) <= 2),
    }


def alias_rules(dictionary: topics.Topics, vocab: list[str]) -> dict:
    """**Even when a rule makes the sample, the arbitrariness of choosing the rule remains.** Swapping the
    alias-choosing rule between four options moves the misroutes of the first 10 topics between 0 and 6
    -- which is why the one `misrouted` number must not be read as this section's answer, and why the
    answer is `ko_in_dictionary` (that side has no alias rule)."""
    present = set(vocab)
    heads = dictionary.entries[:SAMPLE]
    picks = {
        "first_ko": [entry["ko"][0] for entry in heads],
        "last_ko": [entry["ko"][-1] for entry in heads],
        "first_inci": [entry["mfds_inci"][0] for entry in heads if entry["mfds_inci"]],
    }
    rates = {name: sum(1 for alias in chosen if alias in present) for name, chosen in picks.items()}
    # `any_ko` is not one alias but "is any one of that topic's aliases caught".
    rates["any_ko"] = sum(1 for entry in heads if set(entry["ko"]) & present)
    return {"of": SAMPLE, "rates": rates, "low": min(rates.values()), "high": max(rates.values())}


def candidates() -> dict:
    """The other lists that could have been canonical for deciding an ingredient name. Why they cannot
    be, as numbers."""
    from db.seed.lexicon import _ingredient_rows

    rows = _ingredient_rows(ROOT / "eval")
    key, surface = 1, 2
    keys_of: dict[str, set[str]] = {}
    for row in rows:
        keys_of.setdefault(str(row[surface]), set()).add(str(row[key]))
    catalogue = list(csv.DictReader(CATALOGUE.open(encoding="utf-8")))
    return {
        "entity_rows": len(rows),
        "entity_keys": len({str(row[key]) for row in rows}),
        "entity_ingredient_keys": sum(1 for row in catalogue if row["category"] == "ingredient"),
        "entity_categories": len({row["category"] for row in catalogue}),
        # If one surface points at two ingredient keys, that surface cannot decide which ingredient it is.
        "entity_ambiguous": sorted(word for word, keys in keys_of.items() if len(keys) > 1),
    }


def published(vocab: list[str]) -> dict:
    decided = [route(query, vocab) for query in PUBLISHED]
    return {
        "queries": len(decided),
        "misrouted": sum(1 for row in decided if row["misrouted"]),
        "traces": {row["query"]: row["hits"] for row in decided},
    }


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("--json", action="store_true", help="Print only in the form the tests read.")
    args = parser.parse_args()

    # A missing source is blocked rather than a failure -- exiting 0 reads as "we measured and found no trap".
    sources = (INGREDIENTS, topics.DICTIONARY_CSV, CATALOGUE, BRANDS)
    missing = [path for path in sources if not path.exists()]
    if missing:
        print(
            "no source to measure: " + ", ".join(str(p.relative_to(ROOT)) for p in missing),
            file=sys.stderr,
        )
        return 2

    dictionary = install_topics()
    vocab = vocabulary()
    measured = {
        "dictionary": dictionary_shape(dictionary, vocab),
        "candidates": candidates(),
        "sample": {**sample(dictionary, vocab), "alias_rules": alias_rules(dictionary, vocab)},
        "ydc_published": published(vocab),
        "brand_only": brand_only(dictionary),
    }
    if args.json:
        print(json.dumps(measured, ensure_ascii=False, indent=2))
        return 0
    report(measured)
    return 0


def report(measured: dict) -> None:
    shape, found = measured["dictionary"], measured["sample"]
    print(
        f"[sample] {found['misrouted']} misrouted of {found['size']} natural-language queries "
        f"· {found['topic_misrouted']} over all {found['topics']} topics "
        f"· {found['frame_signals']} ingredient signals from the frames"
    )
    for position, row in enumerate(found["rows"]):
        mark = "misrouted" if row["misrouted"] else "         "
        edge = "   " if position < found["size"] else "(out)"
        print(f"  {edge} {mark} {row['route']:6s} {row['hits']!s:24s} {row['query']}")
    print(
        f"\n[ydc published] {measured['ydc_published']['misrouted']}/{measured['ydc_published']['queries']}"
    )
    for query, hits in measured["ydc_published"]["traces"].items():
        print(f"        {hits!s:24s} {query}")
    print(
        f"\n[dictionary] ingredient dictionary {shape['surfaces']:,} surfaces "
        f"· {shape['ko_in_dictionary']} of the {shape['ko_aliases']} words people use (`ko`) are in it"
    )
    print(f"        {shape['ko_caught']}")
    print(
        f"        {shape['inci_in_dictionary']} of the {shape['inci_surfaces']} ingredient surfaces "
        f"(`mfds_inci`) · of those, the ones people also use {shape['inci_also_asked_with']}"
    )
    wobble = found["alias_rules"]
    print(
        f"        changing the alias-choosing rule moves it {wobble['low']}~{wobble['high']}/{wobble['of']} "
        f"· {wobble['rates']}"
    )
    only = measured["brand_only"]
    print(
        f"\n[router without the ingredient axis] {only['misrouted']} of {only['queries']} topic aliases "
        f"sent to bm25 · {only['correct']} of those sent correctly"
    )
    for query, hits in only["traces"].items():
        print(f"        {query} <- {hits}")
    print(
        f"        brands {only['rows']} rows / {only['surfaces']} distinct surfaces "
        f"· of those, two characters or fewer {only['short_surfaces']}"
    )
    other = measured["candidates"]
    print(
        f"\n[other candidates] entity_lexicon kind='ingredient' {other['entity_rows']} rows "
        f"/ {other['entity_keys']} keys · category is {other['entity_categories']} kinds and ingredient is "
        f"{other['entity_ingredient_keys']} keys "
        f"· surfaces pointing at two ingredients {other['entity_ambiguous']}"
    )


if __name__ == "__main__":
    raise SystemExit(main())
