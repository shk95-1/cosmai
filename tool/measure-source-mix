#!/usr/bin/env python3
"""Is the global top k dominated by the index composition (fork #54, the per-source split in ydc's
`rag/engine.py`).

ydc draws per source and merges, because **92% of its index is short youtube comments**, so the global
top k pushed `mfds` down to **rank 293** and `ingredient` **beyond rank 300**. Our
`ranked_chunks(..., sources=...)` only **narrows** the candidates by `sources`, so it has no per-source
share. This tool measures whether the condition that needs such a share exists in our corpus too --
putting RRF in before measuring whether it is needed is what this measurement is there to stop.

**The four verdict criteria were fixed before measuring.** The criteria are not made after seeing the
result. They live only in the two constants `K`·`BURIED_RANK` and the one function `verdict`, and
`tests/retrieval/test_source_mix.py` holds their meaning.

    쏠리지 않는다  전역 top-k 의 지배 소스 점유율 < 그 소스의 색인 구성비 -- ydc 의 조건 자체가 없다
    밀리지 않는다  쏠리되, 후보를 가진 소수 소스의 첫 등장 순위 **중앙값** < BURIED_RANK
    지배한다       쏠리고, 그 중앙값 >= BURIED_RANK -- 여기서만 분배가 살 자리가 있다
    측정 불가      후보를 가진 소수 소스가 하나도 없다

**The median carries the verdict.** Judging by one query's rank 777 yields dominance on any corpus --
the tail is always long. **The queries are not picked**: they are the topic aliases
`cosmai retrieval eval --mode literal` uses, and since the canonical copy is the active version of
`needs.aspect_lexicon`, they are read from the DB.

The two parts have different heavy dependencies. `mix` is one GROUP BY statement, while `topk` opens the
BM25 index (without a cache, over ten minutes on 380k chunks -- 474 seconds measured).

    uv run --extra retrieval tool/measure-source-mix              # both
    uv run --extra retrieval tool/measure-source-mix --json
    uv run --extra retrieval tool/measure-source-mix --part mix   # does not open the index

종료 코드: 0 답이 계산됐다 · 2 막힘(활성 주제 사전이 없다 · 청크가 비었다 -- `contracts/entrypoints.md`
§검색 의 blocked 와 같은 자리다).
"""

from __future__ import annotations

import argparse
import json
import statistics
import sys
from pathlib import Path
from typing import NamedTuple

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from analysis.retrieval import eval as retrieval_eval  # noqa: E402
from analysis.retrieval import topics  # noqa: E402

K = 10  # 상위 k. 계약 §검색 실측 과 `analysis/retrieval/eval.K` 가 쓰는 그 k 다
# The threshold for "buried". The same order of magnitude as ydc's rank 293 and beyond-300, and ten
# times k -- the only ground a split stands on is that a minority source is **not** near the top k, so
# that absence has to be visible as an order of magnitude.
BURIED_RANK = 100
NO_SKEW = "쏠리지 않는다"
NOT_BURIED = "밀리지 않는다"
DOMINATED = "지배한다"
UNMEASURABLE = "측정 불가"
YDC_SHARE = 0.92  # the share short youtube comments took in the ydc index
YDC_RANKS = (293, 300)  # where mfds sat and where ingredient went beyond, in that index

COMPOSITION = """
SELECT source, count(*) AS chunks, count(DISTINCT doc_id) AS docs
FROM retrieval_chunk GROUP BY source ORDER BY chunks DESC
"""


class Share(NamedTuple):
    # It is not a dataclass because this file is also opened with `SourceFileLoader`, without an
    # extension -- on that path the module is not in sys.modules and dataclass blows up resolving the
    # string annotations.
    source: str
    chunks: int
    docs: int
    chunk_share: float = 0.0
    doc_share: float = 0.0


def composition(conn) -> list[Share]:
    """(chunks, documents) per source. **Counted in one scan** -- asking per source makes four full scans
    over 380k rows, and there is no guarantee the four fit inside statement_timeout (30s) (all the more
    while another worker reads the same DB)."""
    with conn.cursor() as cur:
        cur.execute(COMPOSITION)
        rows = [(str(s), int(c), int(d)) for s, c, d in cur.fetchall()]
    conn.commit()  # a 380k-chunk index is opened next -- do not leave with a transaction open
    chunks = sum(c for _s, c, _d in rows) or 1
    docs = sum(d for _s, _c, d in rows) or 1
    return [Share(s, c, d, c / chunks, d / docs) for s, c, d in rows]


def verdict(index_share: float, topk_share: float, first_ranks: list[int]) -> str:
    """Judges by the criteria fixed in advance. **The criteria are not made after seeing the result.**"""
    if topk_share < index_share:
        return NO_SKEW
    if not first_ranks:
        return UNMEASURABLE
    return DOMINATED if statistics.median(first_ranks) >= BURIED_RANK else NOT_BURIED


def per_query(index, origin: dict[str, str], query: str, dominant: str, k: int = K) -> dict | None:
    """One query's (top-k source composition, first appearance rank of the minority sources). None when
    there are 0 candidates -- a rank that does not exist is not invented. The full ranking is taken
    because where beyond k the first appearance falls is half of this measurement."""
    ranked = index.search(query, k=None)
    if not ranked:
        return None
    first: dict[str, int] = {}
    pool: dict[str, int] = {}
    for rank, (chunk_id, _score) in enumerate(ranked, 1):
        source = origin[chunk_id]
        pool[source] = pool.get(source, 0) + 1
        first.setdefault(source, rank)
    head = [origin[chunk_id] for chunk_id, _score in ranked[:k]]
    return {
        "query": query,
        "candidates": len(ranked),
        "top_k": {source: head.count(source) for source in sorted(set(head))},
        "dominant_share": head.count(dominant) / len(head),
        "minority_first": {s: r for s, r in sorted(first.items()) if s != dominant},
        "pool": dict(sorted(pool.items())),
    }


def measure(conn, cache_dir: Path | None, k: int = K) -> dict:
    from analysis.retrieval.pipeline import load_index

    shares = composition(conn)
    if not shares:
        raise SystemExit("the chunks are empty -- `cosmai retrieval chunk` comes first (blocked)")
    dominant = shares[0].source
    dictionary = topics.use_active(conn)
    index, origin = load_index(conn, None, cache_dir=cache_dir)
    conn.commit()

    rows = [
        r
        for _topic, q in retrieval_eval.queries("literal", dictionary)
        if (r := per_query(index, origin, q, dominant, k))
    ]
    counted: dict[str, int] = {}
    for row in rows:
        for source, n in row["top_k"].items():
            counted[source] = counted.get(source, 0) + n
    total = sum(counted.values()) or 1
    ranks = [
        rank for row in rows for source, rank in row["minority_first"].items() if row["pool"].get(source)
    ]
    by_source: dict[str, dict] = {}
    for share in shares:
        if share.source == dominant:
            continue
        # Also given per source -- one pooled median hides a bimodal "wins sometimes, buried mostly".
        own = [row["minority_first"][share.source] for row in rows if row["pool"].get(share.source)]
        by_source[share.source] = {
            "queries_with_candidates": len(own),
            "beyond_k": sum(1 for rank in own if rank > k),
            "within_k": sum(1 for rank in own if rank <= k),
            "median": statistics.median(own) if own else None,
            "max": max(own) if own else None,
        }
    index_share = next(s.chunk_share for s in shares if s.source == dominant)
    topk_share = counted.get(dominant, 0) / total
    return {
        "chunks": sum(s.chunks for s in shares),
        "dictionary": dictionary.version,
        "dominant": dominant,
        "composition": [s._asdict() for s in shares],
        "queries": len(rows),
        "queries_without_candidates": len(retrieval_eval.queries("literal", dictionary)) - len(rows),
        "top_k": {
            source: {"n": n, "share": n / total}
            for source, n in sorted(counted.items(), key=lambda kv: -kv[1])
        },
        "dominant_share_in_index": index_share,
        "dominant_share_in_top_k": topk_share,
        "dominant_share_mean_per_query": statistics.mean(r["dominant_share"] for r in rows) if rows else 0.0,
        "minority_first_rank": {
            "n": len(ranks),
            "median": statistics.median(ranks) if ranks else None,
            "max": max(ranks) if ranks else None,
            "beyond_k": sum(1 for rank in ranks if rank > k),
        },
        "minority_first_rank_by_source": by_source,
        "queries_with_only_dominant_in_top_k": sum(1 for r in rows if set(r["top_k"]) == {dominant}),
        "verdict": verdict(index_share, topk_share, ranks),
        "rows": rows,
    }


def report(measured: dict) -> None:
    # Left alone rather than reflowed: the columns of this report are aligned by hand.
    # fmt: off
    print(f"chunks {measured['chunks']:,} · topic dictionary v{measured['dictionary']}"
          f" · queries {measured['queries']} (0 candidates: {measured['queries_without_candidates']})")
    print("\nindex composition")
    for share in measured["composition"]:
        print(f"  {share['source']:20s} chunks {share['chunks']:>8,} {share['chunk_share'] * 100:6.2f}%"
              f" · documents {share['docs']:>8,} {share['doc_share'] * 100:6.2f}%")
    print(f"\nsource distribution of the global top {K} (pooled over {measured['queries']} queries)")
    for source, cell in measured["top_k"].items():
        print(f"  {source:20s} {cell['n']:>5} {cell['share'] * 100:6.2f}%")
    first = measured["minority_first_rank"]
    print(f"\ndominant source {measured['dominant']}:"
          f" index {measured['dominant_share_in_index'] * 100:.2f}%"
          f" -> top {K} {measured['dominant_share_in_top_k'] * 100:.2f}%"
          f" (mean per query {measured['dominant_share_mean_per_query'] * 100:.2f}%)")
    print(f"minority sources with candidates (query, source) {first['n']} pairs"
          f" · median first rank {first['median']}"
          f" · max {first['max']} · beyond top {K} {first['beyond_k']}")
    for source, cell in measured["minority_first_rank_by_source"].items():
        print(f"  {source:20s} queries with candidates {cell['queries_with_candidates']:3d} · within top {K}"
              f" {cell['within_k']:3d} · beyond {cell['beyond_k']:3d} · median first rank {cell['median']}"
              f" · max {cell['max']}")
    print(f"queries whose top {K} is the dominant source only:"
          f" {measured['queries_with_only_dominant_in_top_k']}")
    print(f"\nverdict: {measured['verdict']}  (criteria: skew is at or above the index share,"
          f" buried is a median at or beyond rank {BURIED_RANK})")
    # fmt: on


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("--part", choices=("mix", "topk", "both"), default="both")
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--url", default=None, help="SQLAlchemy URL; default is needs_runtime.")
    parser.add_argument("--cache-dir", default=None, help="BM25 index cache. Default is pipeline.CACHE_DIR")
    args = parser.parse_args()

    from analysis.retrieval.pipeline import CACHE_DIR
    from cosmai.cli import _connect

    cache_dir = Path(args.cache_dir) if args.cache_dir else CACHE_DIR
    try:
        with _connect(args.url) as conn:
            if args.part == "mix":
                shares = composition(conn)
                measured = {"composition": [s._asdict() for s in shares]}
            else:
                measured = measure(conn, cache_dir)
    except topics.NoDictionary as exc:
        print(f"{exc} (blocked)", file=sys.stderr)
        return 2
    except SystemExit as exc:
        print(str(exc), file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps(measured, ensure_ascii=False, indent=2))
    elif args.part == "mix":
        # fmt: off
        for share in measured["composition"]:
            print(f"  {share['source']:20s} chunks {share['chunks']:>8,} {share['chunk_share'] * 100:6.2f}%"
                  f" · documents {share['docs']:>8,} {share['doc_share'] * 100:6.2f}%")
        # fmt: on
    else:
        report(measured)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
