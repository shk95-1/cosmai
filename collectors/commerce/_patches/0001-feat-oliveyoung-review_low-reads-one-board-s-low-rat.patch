@@ -0,0 +1,238 @@
+"""One board's low-rated reviews, walked to exhaustion.
+
+The `review` walk reads three pages of each rating end for two products a board,
+which is a sample. This one reads the whole low end of ten products on one
+board: `RATING_ASC` hands back every one-star review, then every two-star,
+recency as the tiebreak within a rating, so six pages of fifty reach the end of
+the complaints for any product measured on 2026-08-19 (189 one-star + 11
+two-star in 200). One `RATING_DESC` page is the satisfaction baseline beside it,
+and the stats request is the site's own distribution to weigh both against.
+
+Same record types, same tables as `review`: what differs is which products and
+how far, which is what `scope` records.
+"""
+
+from __future__ import annotations
+
+import json
+from datetime import UTC, datetime
+from pathlib import Path
+
+from trend_radar.contract import Fetch, Payload, Transport
+from trend_radar.models import Dataset, RankRecord
+from trend_radar.sources.oliveyoung import (
+    _BOARDS,
+    LOW_ASC_PAGES,
+    LOW_BOARD,
+    LOW_DESC_PAGES,
+    LOW_PRODUCTS,
+    REVIEW_ENDPOINT,
+    REVIEW_PAGES,
+    OliveYoung,
+)
+
+AT = datetime(2026, 8, 23, 3, tzinfo=UTC)
+FIXTURES = Path(__file__).parent.parent / "fixtures/oliveyoung"
+GOODS = "A000000223414"
+
+
+def _ranking_out(dataset: Dataset = Dataset.REVIEW_LOW):
+    fetch = OliveYoung().seeds(dataset)[0]
+    payload = Payload(
+        fetch=fetch,
+        status=200,
+        body=(FIXTURES / "ranking/best-skincare.html").read_bytes(),
+        final_url=fetch.url,
+        headers={},
+        elapsed_ms=1,
+        captured_at=AT,
+    )
+    return OliveYoung().parse(payload)  # pyright: ignore[reportArgumentType]
+
+
+def _review_payload(body: dict, *, sort: str, page: int, pages: int) -> Payload:
+    fetch = Fetch(
+        url=REVIEW_ENDPOINT,
+        dataset=Dataset.REVIEW_LOW,
+        method="POST",
+        transport=Transport.HTTP,
+        context=(
+            ("kind", "reviews"),
+            ("product", GOODS),
+            ("sort", sort),
+            ("page", str(page)),
+            ("pages", str(pages)),
+        ),
+    )
+    return Payload(
+        fetch=fetch,
+        status=200,
+        body=json.dumps(body).encode(),
+        final_url=REVIEW_ENDPOINT,
+        headers={},
+        elapsed_ms=1,
+        captured_at=AT,
+    )
+
+
+def _capture() -> dict:
+    return json.loads((FIXTURES / "review/list.json").read_bytes())
+
+
+# --- what the source declares -------------------------------------------------
+
+
+def test_review_low_is_a_dataset_this_source_collects():
+    assert Dataset.REVIEW_LOW in OliveYoung.datasets
+
+
+def test_the_low_board_is_a_board_this_source_walks():
+    assert LOW_BOARD in {board.name for board in _BOARDS}
+
+
+def test_the_low_walk_starts_from_exactly_one_board():
+    seeds = OliveYoung().seeds(Dataset.REVIEW_LOW)
+    assert len(seeds) == 1
+    assert seeds[0].ctx("board") == LOW_BOARD
+    assert seeds[0].dataset is Dataset.REVIEW_LOW
+    assert seeds[0].ctx("kind") == "ranking"
+
+
+def test_the_asc_walk_is_deeper_than_the_review_walk():
+    # The point: the review walk samples, this one exhausts. If this stops
+    # being true the dataset is a second copy of `review` on another board.
+    assert LOW_ASC_PAGES > REVIEW_PAGES
+    assert LOW_DESC_PAGES == 1
+
+
+# --- what the ranking follows -------------------------------------------------
+
+
+def test_a_low_run_writes_no_rank_rows():
+    assert not [r for r in _ranking_out().records if isinstance(r, RankRecord)]
+
+
+def test_the_first_products_get_three_follows_each():
+    follow = _ranking_out().follow
+    products = [f.ctx("product") for f in follow]
+    assert len(set(products)) == LOW_PRODUCTS
+    assert len(follow) == LOW_PRODUCTS * 3
+    for product in set(products):
+        kinds = sorted(f.ctx("kind") or "" for f in follow if f.ctx("product") == product)
+        assert kinds == ["reviews", "reviews", "stats"]
+
+
+def test_products_past_the_cap_are_not_followed():
+    ranking = _ranking_out(Dataset.RANKING)
+    ranked = [r for r in ranking.records if isinstance(r, RankRecord)]
+    assert len(ranked) > LOW_PRODUCTS
+    head = {r.product_key for r in ranked if r.rank <= LOW_PRODUCTS}
+    assert {f.ctx("product") for f in _ranking_out().follow} == head
+
+
+def test_each_review_follow_carries_its_sort_and_its_own_page_cap():
+    reviews = [f for f in _ranking_out().follow if f.ctx("kind") == "reviews"]
+    caps = {(f.ctx("sort"), f.ctx("pages")) for f in reviews}
+    assert caps == {("RATING_ASC", str(LOW_ASC_PAGES)), ("RATING_DESC", str(LOW_DESC_PAGES))}
+    assert all(f.ctx("page") == "0" for f in reviews)
+    assert all(json.loads(f.body or b"{}")["sortType"] == f.ctx("sort") for f in reviews)
+
+
+def test_every_follow_belongs_to_the_low_dataset():
+    # fetch_log records the dataset per request; a low-walk request filed
+    # under `review` would make that column say a run happened that did not.
+    assert {f.dataset for f in _ranking_out().follow} == {Dataset.REVIEW_LOW}
+
+
+def test_the_low_walk_asks_for_stats_but_not_the_summary():
+    kinds = {f.ctx("kind") for f in _ranking_out().follow}
+    assert "stats" in kinds
+    assert "summary" not in kinds
+
+
+def test_the_review_walk_is_untouched():
+    # The existing walk keeps its own cap and its own dataset.
+    from trend_radar.sources.oliveyoung import REVIEW_PRODUCTS_PER_BOARD
+
+    follow = _ranking_out(Dataset.REVIEW).follow
+    assert len(follow) == REVIEW_PRODUCTS_PER_BOARD * 2
+    assert {f.dataset for f in follow} == {Dataset.REVIEW}
+    assert {f.ctx("pages") for f in follow} == {str(REVIEW_PAGES)}
+
+
+# --- the page walk ------------------------------------------------------------
+
+
+def test_an_asc_page_with_more_behind_it_keeps_walking():
+    out = OliveYoung().parse(
+        _review_payload(_capture(), sort="RATING_ASC", page=4, pages=LOW_ASC_PAGES)
+    )
+    assert len(out.follow) == 1
+    nxt = out.follow[0]
+    assert nxt.ctx("page") == "5"
+    assert nxt.ctx("pages") == str(LOW_ASC_PAGES)
+    assert nxt.ctx("sort") == "RATING_ASC"
+    assert nxt.dataset is Dataset.REVIEW_LOW
+
+
+def test_the_asc_walk_stops_at_its_own_cap():
+    out = OliveYoung().parse(
+        _review_payload(_capture(), sort="RATING_ASC", page=LOW_ASC_PAGES - 1, pages=LOW_ASC_PAGES)
+    )
+    assert out.follow == ()
+
+
+def test_the_desc_walk_stops_after_one_page():
+    out = OliveYoung().parse(
+        _review_payload(_capture(), sort="RATING_DESC", page=0, pages=LOW_DESC_PAGES)
+    )
+    assert out.follow == ()
+
+
+def test_the_site_saying_no_more_ends_the_asc_walk_early():
+    # The cap is a ceiling, not a quota: most products run out of one- and
+    # two-star reviews well before six pages.
+    data = _capture()
+    data["data"]["hasNext"] = False
+    out = OliveYoung().parse(_review_payload(data, sort="RATING_ASC", page=1, pages=LOW_ASC_PAGES))
+    assert out.follow == ()
+
+
+def test_a_review_fetch_without_a_cap_still_stops_at_review_pages():
+    # The existing `review` walk's requests carry no `pages`; the default is
+    # what it has always been.
+    fetch = Fetch(
+        url=REVIEW_ENDPOINT,
+        dataset=Dataset.REVIEW,
+        method="POST",
+        transport=Transport.HTTP,
+        context=(
+            ("kind", "reviews"),
+            ("product", GOODS),
+            ("sort", "RATING_ASC"),
+            ("page", str(REVIEW_PAGES - 1)),
+        ),
+    )
+    payload = Payload(
+        fetch=fetch,
+        status=200,
+        body=json.dumps(_capture()).encode(),
+        final_url=REVIEW_ENDPOINT,
+        headers={},
+        elapsed_ms=1,
+        captured_at=AT,
+    )
+    assert OliveYoung().parse(payload).follow == ()
+
+
+# --- the budget ---------------------------------------------------------------
+
+
+def test_the_low_walk_fits_the_run_budget():
+    budget = OliveYoung.policy.max_requests_per_run
+    assert budget is not None
+    seeds = len(OliveYoung().seeds(Dataset.REVIEW_LOW))
+    worst_case = seeds + LOW_PRODUCTS * (LOW_ASC_PAGES + LOW_DESC_PAGES + 1)
+    assert worst_case <= budget, f"{worst_case} > {budget}"
+    # Retry room, same rule as the other walks.
+    assert budget - worst_case >= 5
