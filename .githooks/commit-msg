#!/bin/sh
# origin: service/trend-radar/.githooks/commit-msg (identical in yt-scrapper)
# reuse: copy as-is; `git config core.hooksPath .githooks`; edit the type list on line ~17 only.
#
# Enforces Conventional Commits, so `git log --oneline` stays readable and
# changelog tooling can group commits by type later.
#
# Entirely stack-agnostic; copy as-is.

subject=$(grep -v '^#' "$1" | sed '/^[[:space:]]*$/d' | head -1)

# Git writes these itself; they are not ours to reformat.
case "$subject" in
  "Merge "*|"Revert "*|fixup!*|squash!*) exit 0 ;;
esac

pattern='^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9._/-]+\))?!?: .+$'

# A branch named <channel>/<issue>-<slug> belongs to exactly one issue (issue #60 rules), and a
# commit that does not name it cannot be traced back or auto-close it. Detached HEAD and other
# branch shapes are not this rule's business.
branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
issue=$(printf '%s' "$branch" | sed -nE 's|^[a-z0-9/-]+/([0-9]+)-[a-z0-9-]+$|\1|p')
if [ -n "$issue" ] && ! grep -v '^#' "$1" | grep -q "#$issue\b"; then
  printf '\n✗ Branch %s belongs to issue #%s; mention #%s in the commit message.\n\n' "$branch" "$issue" "$issue" >&2
  exit 1
fi

# A bare "Closes #n" is only correct in the repo it is committed to: once the commit is merged
# into a fork, GitHub re-resolves the same #n against the fork and closes an unrelated fork issue
# (#175). "owner/repo#n" survives the merge unchanged, so keyword+bare-# is rejected outright.
# Scanned against the whole message (subject included, not just the body) -- a Conventional
# Commits subject never matches this pattern by construction, and staying conservative costs
# nothing (#175 review, minor 6).
# GitHub also lets one keyword govern a comma list ("Closes owner/repo#1, #2"); every ref after
# the keyword is checked, not just the first, so a bare #n later in the list cannot hide behind a
# properly-qualified one before it (#175 review, should-fix 1).
# The keyword must stand on its own word, both sides -- "disclose #175" and "prefixes #175" are
# not closing keywords, and matching them as substrings was a round-2 regression (#175 re-review).
bare_closes=$(grep -v '^#' "$1" | awk '
  {
    low = tolower($0)
    if (match(low, /(^|[^[:alnum:]_])(close[sd]?|fix(e[sd])?|resolve[sd]?)([^[:alnum:]_]|$)/)) {
      rest = substr($0, RSTART)
      stripped = rest
      gsub(/[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+#[0-9]+/, "", stripped)
      if (stripped ~ /#[0-9]+/) print $0
    }
  }
')
if [ -n "$bare_closes" ]; then
  cat >&2 <<EOF

✗ Bare closing keyword closes the wrong issue once this commit merges into a fork (the same
  #n is re-resolved against whichever repo receives the merge).

  Got:      $(printf '%s\n' "$bare_closes" | head -1)
  Expected: Closes owner/repo#n

  Example:  Closes shk95-1/cosmai#175

EOF
  exit 1
fi

if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
  cat >&2 <<EOF

✗ Commit message is not a Conventional Commit.

  Got:      $subject
  Expected: <type>(<optional scope>): <description>

  Types:    build chore ci docs feat fix perf refactor revert style test
  Examples: feat(auth): add passwordless sign-in
            fix(db): stop save from rewinding the revision
            feat(api)!: make list endpoints paginated

EOF
  exit 1
fi

# Long subjects get truncated by every tool that displays them.
# wc -m, not ${#subject}: under /bin/sh (dash) ${#} counts bytes, which makes a
# 25-character Korean subject "too long". Characters are what a terminal shows.
subject_len=$(printf '%s' "$subject" | wc -m)
if [ "$subject_len" -gt 72 ]; then
  printf '\n✗ Subject is %s characters; keep it under 72.\n\n  %s\n\n' "$subject_len" "$subject" >&2
  exit 1
fi
