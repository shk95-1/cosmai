# origin: service/cosmai/config/env.example (cosmai-old) + service/stack/env.example
# reuse: commit THIS file (names only); the real store is ~/.config/cosmai/env, mode 600, same KEY=VALUE syntax.
#
# Naming: <PROJECT>_SRC_<SOURCE_ID>_<PURPOSE> for source credentials; the `credential_ref` stored in a
# source row is exactly this key name. A connection string with a password is a credential too.
#
# COSMAI_SRC_NAVER_DATALAB_CLIENT_ID=
# COSMAI_SRC_NAVER_DATALAB_CLIENT_SECRET=
# COSMAI_SRC_TUBEDEPTH_API_KEY=
#
# --- stack/.env (compose) : role passwords, never the same value twice ---------------------------
# TREND_RADAR_RUNTIME_PASSWORD=
# TREND_RADAR_READER_PASSWORD=
# TUBEDEPTH_MIGRATOR_PASSWORD=
# TUBEDEPTH_RUNTIME_PASSWORD=
# NEEDS_MIGRATOR_PASSWORD=
# NEEDS_RUNTIME_PASSWORD=
# SERVICE_DATA_DIR=../service-data   # only when the standard sibling layout differs on this machine
