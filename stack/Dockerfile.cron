# stack/Dockerfile's image + supercronic. Why two stages rather than one:
#   - stack/Dockerfile is the image a deploy checks. Its last RUN executes `cosmai --help`,
#     `db/migrate.sh --help`, `ls contracts/ddl/needs/*.sql`, and a site-packages import inside the
#     image, and tests/test_image_payload.py holds that COPY scope to account. Touching that stage just
#     to add a scheduler would move the file that #2's reasoning rests on, along with it.
#   - A one-shot run (`docker compose run --rm collector-commerce cosmai analyze all`, db/migrate.sh)
#     needs no scheduler.
#
# The build happens in two stages -- the FROM below picks up the first stage's result. Running both at
# once is tool/stack-build's job, and the reason `compose build` alone must never be run is the tag
# right below this:
#   docker build -f stack/Dockerfile -t cosmai-needs:local .   (from the repo root)
#   docker compose -f stack/docker-compose.yml build
#
# Why the default is not `cosmai`: on the deploy host that name already belongs to the old fleet's
# archived app image, and the shared-db container set is running it. Skipping the first line does not
# fail FROM -- it picks up that image instead, which has no crontab.d/* because its WORKDIR differs, so
# the failure is pushed from build time to runtime.
ARG COSMAI_IMAGE=cosmai-needs:local
FROM ${COSMAI_IMAGE}

# supercronic: cron semantics with no root daemon -- runs in the foreground as the container's user and
# leaves each job's exit status in the log. So a failed hour lands in `docker logs`, not a mail spool no
# one reads. The version and checksum are the same values service/trend-radar/Dockerfile already runs in
# production. linux-amd64 only, and the checksum turns a wrong-architecture or tampered download into a
# build failure instead of a startup failure.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && curl -fsSLo /usr/local/bin/supercronic \
      https://github.com/aptible/supercronic/releases/download/v0.2.49/supercronic-linux-amd64 \
 && echo "e63c11a9726b775a6a11801e81af4f3fb926aa68  /usr/local/bin/supercronic" | sha1sum -c - \
 && chmod +x /usr/local/bin/supercronic \
 && apt-get purge -y curl \
 && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*

# No default crontab: which lines run differs per container, and that choice is made by compose's
# command.
CMD ["supercronic", "-h"]
