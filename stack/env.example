# The non-secret knobs stack/docker-compose.yml reads. `cp stack/env.example stack/.env` and fill it in.
# compose reads the .env in the directory holding its own file. The one exception is OLD_STACK_DIR at
# the bottom, and that line is read from this same file by stack/rollback.sh.
#
# ────────────────────────────────────────────────────────────────────────────────
# No secret lives here.
#
# The source of truth is contracts/secrets.md, and the values live in exactly one place:
# ~/.config/cosmai/env (KEY=VALUE, mode 600). compose mounts that file read-only into the container and
# db/secrets.py reads it through COSMAI_SECRET_FILE -- the value never lands in this file, in compose, or
# in an image layer.
#
# The **names** of the keys that file must carry (the values are not written here):
#
#   COSMA_SRC_NAVER_BLOG_CLIENT_ID       collector-naver
#   COSMA_SRC_NAVER_BLOG_CLIENT_SECRET   collector-naver
#   YOUTUBE_DATA_API_TOKEN               collector-youtube-work (trending only)
#   COSMA_SRC_TUBEDEPTH_API_KEY          collector-youtube-work (only when guarding the tubedepth api)
#   NEEDS_DB_MIGRATOR                    db/migrate.sh (run from the host)
#   NEEDS_DB_RUNTIME                     every scheduler (db/runtime.py)
#   CLAUDE_API_KEY                       analyze (the LLM plug-in point in analysis/polarity)
#
# When a key needed at boot is missing, db/secrets.py names only the key and exits (contracts/secrets.md).
# ────────────────────────────────────────────────────────────────────────────────

# The host's absolute path to the file above. No default -- leaving it out makes compose refuse to
# start, naming this variable. compose does not expand ~, so this is written as an absolute path.
COSMAI_SECRET_FILE_HOST=

# The DB the needs schema lives in. It is the value compose passes to the schedulers
# (contracts/entrypoints.md §DB connection knobs) and an address inside the network, so it is not a thing to
# change in this file — it is written here so the value used by `uv run cosmai ...` on the host is visible
# alongside.
#   in the compose network: COSMAI_DB_HOST=postgres    COSMAI_DB_PORT=5432
#   on the host:             COSMAI_DB_HOST=127.0.0.1   COSMAI_DB_PORT=5434
# Both are db/runtime.py's defaults, and `postgres` is the service stack/docker-compose.yml now
# declares itself (#177) -- it used to be the old fleet's shared-postgres container.

# Host path of the Postgres data directory the `postgres` service opens (#177). Not a secret: it
# is a location, and the cluster it names already carries its own roles and passwords -- which is
# also why that service sets no POSTGRES_PASSWORD.
#
# No default, for the reason COSMAI_SECRET_FILE_HOST above has none: compose's project name and
# the container name are fixed, so `up` from any checkout aims at the same production container,
# and a default that resolved differently per checkout would recreate it over the wrong directory.
# Absolute path -- compose does not expand ~ -- and missing means compose refuses to start.
#
# Give it the PARENT of PGDATA: the cluster itself is `18/docker` underneath it, which is where
# the postgres:18 image looks. On this host the value is the mount the dead old-stack container
# had, `../service/service-data/postgres` relative to this repo's root, written out absolutely.
COSMAI_PG_DATA_DIR=

# The port the portal opens on the host. Same exposure range as PostgREST (3000).
NEEDS_PORTAL_PORT=3003

# The directory stack/rollback.sh looks in for the old stack's (compose project shared-db's) compose
# file. This can be a path relative to this repo's root or an absolute path. compose never references
# this value -- it is the one line in this file read by rollback.sh rather than compose, and that script
# reads it directly here (process environment first, falling back to stack/.env). A value filled in
# during an incident must never be ignored.
OLD_STACK_DIR=../service/stack

# collector-commerce's browser profile (#27). The default is a path relative to stack/, resolving to
# var/browser-profiles at the repo root -- the exact directory `cosmai login` (run on the host, from the
# repo root) writes to. If the two point elsewhere from each other, a human logging in leaves the
# collector unable to use it. The same pattern for the same reason as the old stack's
# TREND_RADAR_PROFILE_DIR (Main/service/stack/docker-compose.yml:156): a bind mount rather than a named
# volume -- so the login window is never forced to open inside a container. Read-write: the site
# refreshes cookies during the session.
COMMERCE_BROWSER_PROFILE_DIR=../var/browser-profiles

# The host ollama the analyze container's gemma4 polarity pass (the 08:00 line in
# stack/crontab.d/analyze) calls. This is not a secret, it is an address -- which is why the value can
# live here, and why contracts/secrets.md leaves this name off its own key list. The default is the only
# path measured to round-trip inside a container (the Windows Tailscale interface WSL2's mirroring
# inherits, 100.64/10). **This address disappears when Tailscale is off** -- this is where it gets
# swapped out when that happens. The LAN address (192.168.10.35) is the fallback for the day a firewall
# rule opens it up. When unreachable, that night's run closes as failed with exit code 1 -- not a quiet
# zero.
OLLAMA_URL=http://100.102.193.98:11434
