# stack/docker-compose.yml 이 읽는 비-secret 노브. `cp stack/env.example stack/.env` 하고 채운다.
# compose 는 자기 파일이 있는 디렉터리의 .env 를 읽는다. 예외는 맨 아래 OLD_STACK_DIR 하나이고,
# 그 줄은 stack/rollback.sh 가 같은 파일에서 읽는다.
#
# ────────────────────────────────────────────────────────────────────────────────
# secret 은 여기 없다.
#
# 정본은 contracts/secrets.md 이고, 값은 ~/.config/cosmai/env (KEY=VALUE, mode 600) 한 곳에만 있다.
# compose 는 그 파일을 컨테이너에 읽기 전용으로 마운트하고 db/secrets.py 가 COSMAI_SECRET_FILE 로
# 읽는다 — 값은 이 파일에도, compose 에도, 이미지 레이어에도 들어가지 않는다.
#
# 그 파일이 담아야 하는 키 **이름**(값은 여기 적지 않는다):
#
#   COSMA_SRC_NAVER_BLOG_CLIENT_ID       collector-naver
#   COSMA_SRC_NAVER_BLOG_CLIENT_SECRET   collector-naver
#   YOUTUBE_DATA_API_TOKEN               collector-youtube-work (trending 전용)
#   COSMA_SRC_TUBEDEPTH_API_KEY          collector-youtube-work (tubedepth api 를 보호할 때만)
#   NEEDS_DB_MIGRATOR                    db/migrate.sh (호스트에서 실행)
#   NEEDS_DB_RUNTIME                     스케줄러 전부 (db/runtime.py)
#   CLAUDE_API_KEY                       analyze (analysis/polarity 의 LLM 삽입점)
#
# 기동 시 필요한 키가 없으면 db/secrets.py 가 키 이름만 말하고 종료한다 (contracts/secrets.md).
# ────────────────────────────────────────────────────────────────────────────────

# 위 파일의 호스트 절대경로. 기본값이 없다 — 빠지면 compose 가 이 이름을 말하며 기동을 거부한다.
# compose 는 ~ 를 펴지 않으므로 절대경로로 쓴다.
COSMAI_SECRET_FILE_HOST=

# needs 스키마가 사는 DB. compose 가 스케줄러에 넘기는 값이며(contracts/entrypoints.md §DB 접속 노브)
# 망 안의 주소라 이 파일에서 바꿀 것이 아니다 — 호스트에서 `uv run cosmai ...` 를 돌릴 때 쓰는 값이
# 무엇인지 같이 보라고 적어 둔다.
#   컨테이너 안: COSMAI_DB_HOST=shared-postgres  COSMAI_DB_PORT=5432
#   호스트에서:  COSMAI_DB_HOST=127.0.0.1        COSMAI_DB_PORT=5434   (둘 다 db/runtime.py 의 기본값)

# portal 이 호스트에 여는 포트. PostgREST(3000)와 같은 노출 범위.
NEEDS_PORTAL_PORT=3003

# stack/rollback.sh 가 구 스택(compose 프로젝트 shared-db)의 compose 파일을 찾는 디렉터리.
# 이 레포 루트 기준 상대경로여도 되고 절대경로여도 된다. compose 는 이 값을 참조하지 않는다 --
# 이 파일에서 유일하게 compose 가 아니라 rollback.sh 가 읽는 줄이고, 그 스크립트가 여기서 직접
# 읽는다(프로세스 환경이 먼저, 없으면 stack/.env). 장애 중에 채워 놓은 값이 무시되면 안 된다.
OLD_STACK_DIR=../service/stack

# collector-commerce 의 브라우저 프로필(#27). 기본값은 stack/ 기준 상대경로라 레포 루트의
# var/browser-profiles 로 풀리며, `cosmai login`(호스트, 레포 루트에서 실행)이 쓰는 바로 그 디렉터리다
# -- 둘이 다른 곳을 보면 사람이 로그인해도 수집기가 못 쓴다. 구 스택의 TREND_RADAR_PROFILE_DIR
# (Main/service/stack/docker-compose.yml:156)과 같은 이유의 같은 패턴: 이름 있는 볼륨이 아니라 bind
# mount -- 로그인 창을 컨테이너 안에서 띄우게 만들지 않기 위해서다. 읽기-쓰기: 사이트가 세션 중 쿠키를
# 갱신한다.
COMMERCE_BROWSER_PROFILE_DIR=../var/browser-profiles

# analyze 컨테이너의 gemma4 극성 패스(stack/crontab.d/analyze 의 08:00 줄)가 부르는 호스트 ollama.
# secret 이 아니라 주소다 -- 값이 여기 있어도 되는 이유이고, contracts/secrets.md 는 그래서 이 이름을
# 자기 키 목록에서 뺀다. 기본값은 컨테이너 안에서 실제 왕복이 성립한 유일한 경로다(WSL2 미러링이
# 물려받은 Windows 의 Tailscale 인터페이스, 100.64/10). **Tailscale 이 꺼지면 사라지는 주소다** --
# 그때 갈아 끼우는 자리가 여기다. LAN 주소(192.168.10.35)는 방화벽 규칙이 열리는 날의 대체 경로.
# 못 닿으면 그 밤의 run 은 failed 로 닫히고 종료 코드 1 이다 -- 조용한 0건이 아니다.
OLLAMA_URL=http://100.102.193.98:11434
